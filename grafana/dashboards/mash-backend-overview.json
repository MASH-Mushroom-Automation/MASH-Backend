{
    "title":  "MASH Backend - System Overview",
    "uid":  "mash-backend-overview",
    "timezone":  "browser",
    "schemaVersion":  27,
    "version":  1,
    "refresh":  "10s",
    "time":  {
                 "from":  "now-1h",
                 "to":  "now"
             },
    "panels":  [
                   {
                       "title":  "API Request Rate",
                       "type":  "graph",
                       "gridPos":  {
                                       "x":  0,
                                       "y":  0,
                                       "w":  12,
                                       "h":  8
                                   },
                       "targets":  [
                                       {
                                           "expr":  "rate(mash_http_requests_total[5m])",
                                           "legendFormat":  "{{method}} {{route}} - {{code}}",
                                           "refId":  "A"
                                       }
                                   ],
                       "yaxes":  [
                                     {
                                         "format":  "reqps",
                                         "label":  "Requests/sec"
                                     },
                                     {
                                         "format":  "short"
                                     }
                                 ]
                   },
                   {
                       "title":  "API Error Rate",
                       "type":  "graph",
                       "gridPos":  {
                                       "x":  12,
                                       "y":  0,
                                       "w":  12,
                                       "h":  8
                                   },
                       "targets":  [
                                       {
                                           "expr":  "rate(mash_http_requests_total{status_code=~\"5..\"}[5m])",
                                           "legendFormat":  "5xx Errors",
                                           "refId":  "A"
                                       },
                                       {
                                           "expr":  "rate(mash_http_requests_total{status_code=~\"4..\"}[5m])",
                                           "legendFormat":  "4xx Errors",
                                           "refId":  "B"
                                       }
                                   ],
                       "yaxes":  [
                                     {
                                         "format":  "reqps",
                                         "label":  "Errors/sec"
                                     },
                                     {
                                         "format":  "short"
                                     }
                                 ]
                   },
                   {
                       "title":  "API Latency (P95)",
                       "type":  "graph",
                       "gridPos":  {
                                       "x":  0,
                                       "y":  8,
                                       "w":  12,
                                       "h":  8
                                   },
                       "targets":  [
                                       {
                                           "expr":  "histogram_quantile(0.95, sum(rate(mash_http_request_duration_seconds_bucket[5m])) by (le, route))",
                                           "legendFormat":  "P95 - {{route}}",
                                           "refId":  "A"
                                       },
                                       {
                                           "expr":  "histogram_quantile(0.99, sum(rate(mash_http_request_duration_seconds_bucket[5m])) by (le, route))",
                                           "legendFormat":  "P99 - {{route}}",
                                           "refId":  "B"
                                       }
                                   ],
                       "yaxes":  [
                                     {
                                         "format":  "s",
                                         "label":  "Latency"
                                     },
                                     {
                                         "format":  "short"
                                     }
                                 ]
                   },
                   {
                       "title":  "Database Query Performance",
                       "type":  "graph",
                       "gridPos":  {
                                       "x":  12,
                                       "y":  8,
                                       "w":  12,
                                       "h":  8
                                   },
                       "targets":  [
                                       {
                                           "expr":  "histogram_quantile(0.95, sum(rate(mash_db_query_duration_seconds_bucket[5m])) by (le, operation))",
                                           "legendFormat":  "P95 - {{operation}}",
                                           "refId":  "A"
                                       }
                                   ],
                       "yaxes":  [
                                     {
                                         "format":  "s",
                                         "label":  "Query Time"
                                     },
                                     {
                                         "format":  "short"
                                     }
                                 ]
                   },
                   {
                       "title":  "Cache Hit Rate",
                       "type":  "graph",
                       "gridPos":  {
                                       "x":  0,
                                       "y":  16,
                                       "w":  12,
                                       "h":  8
                                   },
                       "targets":  [
                                       {
                                           "expr":  "mash_cache_hit_rate",
                                           "legendFormat":  "Hit Rate",
                                           "refId":  "A"
                                       }
                                   ],
                       "yaxes":  [
                                     {
                                         "format":  "percentunit",
                                         "label":  "Hit Rate",
                                         "max":  1,
                                         "min":  0
                                     },
                                     {
                                         "format":  "short"
                                     }
                                 ],
                       "thresholds":  [
                                          {
                                              "value":  0.7,
                                              "colorMode":  "critical",
                                              "op":  "lt",
                                              "fill":  true,
                                              "line":  true
                                          }
                                      ]
                   },
                   {
                       "title":  "Active Database Connections",
                       "type":  "graph",
                       "gridPos":  {
                                       "x":  12,
                                       "y":  16,
                                       "w":  12,
                                       "h":  8
                                   },
                       "targets":  [
                                       {
                                           "expr":  "mash_db_connections_active",
                                           "legendFormat":  "Active Connections",
                                           "refId":  "A"
                                       },
                                       {
                                           "expr":  "mash_db_connections_idle",
                                           "legendFormat":  "Idle Connections",
                                           "refId":  "B"
                                       }
                                   ],
                       "yaxes":  [
                                     {
                                         "format":  "short",
                                         "label":  "Connections"
                                     },
                                     {
                                         "format":  "short"
                                     }
                                 ]
                   },
                   {
                       "title":  "Orders Created (Last Hour)",
                       "type":  "stat",
                       "gridPos":  {
                                       "x":  0,
                                       "y":  24,
                                       "w":  6,
                                       "h":  4
                                   },
                       "targets":  [
                                       {
                                           "expr":  "increase(mash_orders_total[1h])",
                                           "refId":  "A"
                                       }
                                   ],
                       "options":  {
                                       "colorMode":  "value",
                                       "graphMode":  "area",
                                       "justifyMode":  "auto",
                                       "orientation":  "auto",
                                       "reduceOptions":  {
                                                             "values":  false,
                                                             "calcs":  [
                                                                           "lastNotNull"
                                                                       ],
                                                             "fields":  ""
                                                         }
                                   },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "thresholds":  {
                                                                               "mode":  "absolute",
                                                                               "steps":  [
                                                                                             {
                                                                                                 "value":  null,
                                                                                                 "color":  "red"
                                                                                             },
                                                                                             {
                                                                                                 "value":  1,
                                                                                                 "color":  "yellow"
                                                                                             },
                                                                                             {
                                                                                                 "value":  10,
                                                                                                 "color":  "green"
                                                                                             }
                                                                                         ]
                                                                           }
                                                        }
                                       }
                   },
                   {
                       "title":  "New User Registrations (Last Hour)",
                       "type":  "stat",
                       "gridPos":  {
                                       "x":  6,
                                       "y":  24,
                                       "w":  6,
                                       "h":  4
                                   },
                       "targets":  [
                                       {
                                           "expr":  "increase(mash_users_registered_total[1h])",
                                           "refId":  "A"
                                       }
                                   ],
                       "options":  {
                                       "colorMode":  "value",
                                       "graphMode":  "area",
                                       "justifyMode":  "auto",
                                       "orientation":  "auto",
                                       "reduceOptions":  {
                                                             "values":  false,
                                                             "calcs":  [
                                                                           "lastNotNull"
                                                                       ],
                                                             "fields":  ""
                                                         }
                                   },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "thresholds":  {
                                                                               "mode":  "absolute",
                                                                               "steps":  [
                                                                                             {
                                                                                                 "value":  null,
                                                                                                 "color":  "red"
                                                                                             },
                                                                                             {
                                                                                                 "value":  1,
                                                                                                 "color":  "yellow"
                                                                                             },
                                                                                             {
                                                                                                 "value":  5,
                                                                                                 "color":  "green"
                                                                                             }
                                                                                         ]
                                                                           }
                                                        }
                                       }
                   },
                   {
                       "title":  "CPU Usage",
                       "type":  "graph",
                       "gridPos":  {
                                       "x":  12,
                                       "y":  24,
                                       "w":  6,
                                       "h":  8
                                   },
                       "targets":  [
                                       {
                                           "expr":  "rate(process_cpu_seconds_total[5m])",
                                           "legendFormat":  "CPU Usage",
                                           "refId":  "A"
                                       }
                                   ],
                       "yaxes":  [
                                     {
                                         "format":  "percentunit",
                                         "label":  "CPU",
                                         "max":  1,
                                         "min":  0
                                     },
                                     {
                                         "format":  "short"
                                     }
                                 ],
                       "thresholds":  [
                                          {
                                              "value":  0.8,
                                              "colorMode":  "critical",
                                              "op":  "gt",
                                              "fill":  true,
                                              "line":  true
                                          }
                                      ]
                   },
                   {
                       "title":  "Memory Usage",
                       "type":  "graph",
                       "gridPos":  {
                                       "x":  18,
                                       "y":  24,
                                       "w":  6,
                                       "h":  8
                                   },
                       "targets":  [
                                       {
                                           "expr":  "process_resident_memory_bytes",
                                           "legendFormat":  "Memory Usage",
                                           "refId":  "A"
                                       }
                                   ],
                       "yaxes":  [
                                     {
                                         "format":  "bytes",
                                         "label":  "Memory"
                                     },
                                     {
                                         "format":  "short"
                                     }
                                 ]
                   },
                   {
                       "title":  "Rate Limit Violations",
                       "type":  "graph",
                       "gridPos":  {
                                       "x":  0,
                                       "y":  32,
                                       "w":  12,
                                       "h":  8
                                   },
                       "targets":  [
                                       {
                                           "expr":  "rate(mash_rate_limit_violations_total[5m])",
                                           "legendFormat":  "{{user_role}} - {{endpoint_category}}",
                                           "refId":  "A"
                                       }
                                   ],
                       "yaxes":  [
                                     {
                                         "format":  "reqps",
                                         "label":  "Violations/sec"
                                     },
                                     {
                                         "format":  "short"
                                     }
                                 ]
                   },
                   {
                       "title":  "Event Loop Lag",
                       "type":  "graph",
                       "gridPos":  {
                                       "x":  12,
                                       "y":  32,
                                       "w":  12,
                                       "h":  8
                                   },
                       "targets":  [
                                       {
                                           "expr":  "nodejs_eventloop_lag_seconds",
                                           "legendFormat":  "Event Loop Lag",
                                           "refId":  "A"
                                       }
                                   ],
                       "yaxes":  [
                                     {
                                         "format":  "s",
                                         "label":  "Lag"
                                     },
                                     {
                                         "format":  "short"
                                     }
                                 ],
                       "thresholds":  [
                                          {
                                              "value":  0.1,
                                              "colorMode":  "critical",
                                              "op":  "gt",
                                              "fill":  true,
                                              "line":  true
                                          }
                                      ]
                   }
               ]
}