{
  "dashboard": {
    "title": "MASH Business Metrics Dashboard",
    "uid": "mash-business-metrics",
    "tags": ["mash", "business", "metrics", "kpi"],
    "timezone": "browser",
    "schemaVersion": 38,
    "refresh": "1m",
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Total Orders (24h)",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "sum(increase(orders_created_total{job=\"mash-backend\"}[24h]))",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "blue" },
                { "value": 100, "color": "green" },
                { "value": 500, "color": "yellow" }
              ]
            },
            "unit": "short"
          }
        },
        "options": {
          "graphMode": "area",
          "colorMode": "background"
        }
      },
      {
        "id": 2,
        "title": "Total Revenue (24h)",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
        "targets": [
          {
            "expr": "sum(increase(revenue_total{job=\"mash-backend\"}[24h]))",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "blue" },
                { "value": 1000, "color": "green" },
                { "value": 10000, "color": "yellow" }
              ]
            },
            "unit": "currencyUSD"
          }
        },
        "options": {
          "graphMode": "area",
          "colorMode": "background"
        }
      },
      {
        "id": 3,
        "title": "Active Users (now)",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
        "targets": [
          {
            "expr": "active_users{job=\"mash-backend\"}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "red" },
                { "value": 10, "color": "yellow" },
                { "value": 50, "color": "green" }
              ]
            },
            "unit": "short"
          }
        },
        "options": {
          "graphMode": "area",
          "colorMode": "value"
        }
      },
      {
        "id": 4,
        "title": "Cache Hit Rate",
        "type": "gauge",
        "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
        "targets": [
          {
            "expr": "rate(cache_hits_total{job=\"mash-backend\"}[5m]) / (rate(cache_hits_total{job=\"mash-backend\"}[5m]) + rate(cache_misses_total{job=\"mash-backend\"}[5m])) * 100",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "red" },
                { "value": 70, "color": "yellow" },
                { "value": 80, "color": "green" }
              ]
            },
            "unit": "percent",
            "min": 0,
            "max": 100
          }
        },
        "options": {
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        }
      },
      {
        "id": 5,
        "title": "Orders Over Time",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
        "targets": [
          {
            "expr": "rate(orders_created_total{job=\"mash-backend\"}[5m]) * 3600",
            "legendFormat": "Orders/hour",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": {
              "axisLabel": "Orders/hour",
              "drawStyle": "line",
              "fillOpacity": 20,
              "lineWidth": 2
            },
            "unit": "short"
          }
        }
      },
      {
        "id": 6,
        "title": "Revenue Over Time",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
        "targets": [
          {
            "expr": "rate(revenue_total{job=\"mash-backend\"}[5m]) * 3600",
            "legendFormat": "Revenue/hour",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": {
              "axisLabel": "$/hour",
              "drawStyle": "line",
              "fillOpacity": 20,
              "lineWidth": 2
            },
            "unit": "currencyUSD"
          }
        }
      },
      {
        "id": 7,
        "title": "Order Status Distribution",
        "type": "piechart",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
        "targets": [
          {
            "expr": "sum by (status) (orders_by_status{job=\"mash-backend\"})",
            "legendFormat": "{{status}}",
            "refId": "A"
          }
        ],
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "right",
            "values": ["value", "percent"]
          },
          "pieType": "pie"
        }
      },
      {
        "id": 8,
        "title": "Top Products by Orders",
        "type": "bargauge",
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
        "targets": [
          {
            "expr": "topk(10, sum by (product_name) (rate(product_orders_total{job=\"mash-backend\"}[1h])))",
            "legendFormat": "{{product_name}}",
            "refId": "A"
          }
        ],
        "options": {
          "orientation": "horizontal",
          "displayMode": "gradient",
          "showUnfilled": true
        },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "continuous-GrYlRd" },
            "unit": "short"
          }
        }
      },
      {
        "id": 9,
        "title": "User Registrations",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
        "targets": [
          {
            "expr": "rate(user_registrations_total{job=\"mash-backend\"}[5m]) * 3600",
            "legendFormat": "Registrations/hour",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": {
              "axisLabel": "Users/hour",
              "drawStyle": "bars",
              "fillOpacity": 80
            },
            "unit": "short"
          }
        }
      },
      {
        "id": 10,
        "title": "Active Devices",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 20 },
        "targets": [
          {
            "expr": "sum(devices_active{job=\"mash-backend\"})",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "red" },
                { "value": 10, "color": "yellow" },
                { "value": 50, "color": "green" }
              ]
            },
            "unit": "short"
          }
        }
      },
      {
        "id": 11,
        "title": "Sensor Data Points (24h)",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 6, "y": 20 },
        "targets": [
          {
            "expr": "sum(increase(sensor_readings_total{job=\"mash-backend\"}[24h]))",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "blue" }
              ]
            },
            "unit": "short"
          }
        }
      },
      {
        "id": 12,
        "title": "Average Order Value",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 12, "y": 20 },
        "targets": [
          {
            "expr": "sum(increase(revenue_total{job=\"mash-backend\"}[24h])) / sum(increase(orders_created_total{job=\"mash-backend\"}[24h]))",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "blue" },
                { "value": 50, "color": "green" },
                { "value": 100, "color": "yellow" }
              ]
            },
            "unit": "currencyUSD",
            "decimals": 2
          }
        }
      },
      {
        "id": 13,
        "title": "System Health Score",
        "type": "gauge",
        "gridPos": { "h": 4, "w": 6, "x": 18, "y": 20 },
        "targets": [
          {
            "expr": "100 - (sum(rate(http_requests_total{job=\"mash-backend\",status_code=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"mash-backend\"}[5m])) * 100)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "red" },
                { "value": 95, "color": "yellow" },
                { "value": 99, "color": "green" }
              ]
            },
            "unit": "percent",
            "min": 0,
            "max": 100
          }
        },
        "options": {
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        }
      }
    ]
  }
}
