# Render production environment template (example)
# DO NOT commit real secrets. Use this file as a template and set secrets in
# the Render dashboard (or via render.yaml with sync: false) before deploying.
# Copy and fill values only for local testing or documentation purposes.

# Application
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Database
# For Render: you can use a Render Postgres service and bind DATABASE_URL from
# the service, or provide an external managed Postgres connection string.
# Example format (do NOT use real credentials in repo):
# DATABASE_URL="postgresql://username:password@host:5432/dbname?schema=public"
DATABASE_URL="YOUR_DATABASE_URL"

# Redis (Upstash recommended) - used for caching, throttling, sockets
REDIS_URL="YOUR_REDIS_URL"

# Authentication / Security
# Generate a long random string for JWT_SECRET in the Render dashboard.
JWT_SECRET="YOUR_JWT_SECRET"
JWT_EXPIRATION=7d

# Clerk / Third-party auth (if used)
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SECRET=""

# File uploads / storage (optional - use S3 for production)
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""

# Email / Notifications
SENDGRID_API_KEY=""
FROM_EMAIL="noreply@yourdomain.com"

# Monitoring & Tracing (OpenTelemetry)
# Point this to your OTLP ingest endpoint (e.g., Grafana Cloud, Honeycomb)
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_SERVICE_NAME="mash-backend"

# Prometheus / Metrics
# If you use a push gateway or remote write, provide its URL; otherwise leave blank
PROMETHEUS_PUSHGATEWAY_URL=""

# Sentry (optional)
SENTRY_DSN=""

# Rate limiting defaults (tunable via Render envs)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Health check path used by Render
HEALTH_CHECK_PATH=/api/v1/health

# --- Notes ---
# 1) Never put real secrets into the repository. Use Render dashboard or secrets
#    management and set values there. If you use render.yaml with `sync: false`,
#    Render will require manual entry in the dashboard for those keys.
# 2) For staging, create a copy of this file and point DATABASE_URL / REDIS_URL to
#    staging services. Use branch=staging in render.yaml for staging deploys.
# 3) For database migrations, prefer running `npx prisma migrate deploy` from CI
#    or via the `scripts/start-prod.sh` wrapper if you accept migrations during
#    container start. See `scripts/start-prod.sh` for the migration-aware startup.
