# ============================================================================
# MASH Backend - Environment Configuration Template
# ============================================================================
# Environment variables for NestJS application with Performance Optimizations
# Last Updated: October 18, 2025 - Railway Deployment Ready
# 
# INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Fill in all required values (marked with YOUR_*)
# 3. Generate secure secrets where indicated
# 4. Never commit .env to version control!
# 
# For Railway Deployment:
# - Use RAILWAY_DEPLOY_NOW.md as your step-by-step guide
# - Railway variables reference: Use ${{service-name.VARIABLE_NAME}} syntax
# - Security: Generate all secrets using: openssl rand -hex 32
# ============================================================================

# ----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ----------------------------------------------------------------------------
# DATABASE CONFIGURATION - PostgreSQL (Neon.tech Optimized)
# ----------------------------------------------------------------------------
# Neon.tech provides two connection strings:
# 1. DATABASE_URL: Pooled connection (PgBouncer) - Use for application queries
# 2. DIRECT_URL: Direct connection - Use for migrations only

# Pooled Connection (Required) - Use this for all Prisma Client connections
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[database]?sslmode=require&pgbouncer=true&connection_limit=9
# Example: postgresql://neondb_owner:npg_xxx@ep-cool-darkness-123456.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=9
DATABASE_URL="postgresql://username:password@localhost:5432/mash_backend_dev?schema=public&sslmode=require&pgbouncer=true&connection_limit=9"

# Direct Connection (Required for Migrations) - Use for `npx prisma migrate deploy`
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[database]?sslmode=require
# Example: postgresql://neondb_owner:npg_xxx@ep-cool-darkness-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DIRECT_URL="postgresql://username:password@localhost:5432/mash_backend_dev?schema=public&sslmode=require"

# Database Connection Pool Settings (Optimized for Neon)
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=9
DATABASE_POOL_IDLE_TIMEOUT=10000
DATABASE_POOL_ACQUIRE_TIMEOUT=30000

# Database Query Timeout (in milliseconds)
# Queries exceeding this timeout will be automatically cancelled
# Default: 30000 (30 seconds) - Recommended range: 10000-60000ms
# Neon Recommended: 20000 (20 seconds) for serverless optimization
DATABASE_QUERY_TIMEOUT_MS=20000

# Slow Query Logging (Performance Monitoring)
LOG_SLOW_QUERIES=true
SLOW_QUERY_THRESHOLD_MS=1000

# ----------------------------------------------------------------------------
# FIREBASE AUTHENTICATION & CLOUD MESSAGING
# ----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_CLIENT_EMAIL=YOUR_FIREBASE_CLIENT_EMAIL
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"
FIREBASE_DATABASE_URL=https://YOUR_PROJECT.firebaseio.com
FIREBASE_AUTH_EMULATOR_HOST=http://127.0.0.1:9099

# Firebase Cloud Messaging (FCM) - for push notifications
FCM_SENDER_ID=YOUR_FCM_SENDER_ID
FCM_SERVICE_ACCOUNT_EMAIL=YOUR_FCM_SERVICE_ACCOUNT_EMAIL
FCM_PRIVATE_KEY_ID=YOUR_FCM_PRIVATE_KEY_ID
FCM_PRIVATE_KEY=YOUR_FCM_PRIVATE_KEY

# ----------------------------------------------------------------------------
# EMAIL CONFIGURATION - Gmail SMTP
# ----------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=YOUR_EMAIL@gmail.com
EMAIL_PASSWORD=YOUR_APP_SPECIFIC_PASSWORD
EMAIL_FROM=Your App Name <YOUR_EMAIL@gmail.com>

# ----------------------------------------------------------------------------
# SENDGRID CONFIGURATION - Alternative Email Service
# ----------------------------------------------------------------------------
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY
SENDGRID_FROM_EMAIL=YOUR_EMAIL@gmail.com

# ----------------------------------------------------------------------------
# TWILIO CONFIGURATION - SMS Alerts
# ----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=YOUR_TWILIO_PHONE_NUMBER

# ----------------------------------------------------------------------------
# REDIS CONFIGURATION - Cloud Redis (Upstash recommended)
# ----------------------------------------------------------------------------
# Used for: Performance caching (Phase 2), BullMQ queues, WebSocket scaling
# Performance Impact: 85-90% cache hit rate, 5x throughput increase
REDIS_HOST=your-redis-host.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD
REDIS_URL="rediss://default:YOUR_REDIS_PASSWORD@your-redis-host.upstash.io:6379"

# Upstash Redis REST API (alternative access method)
UPSTASH_REDIS_REST_URL="https://your-redis-host.upstash.io"
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_TOKEN

# Cache Configuration (Performance Optimization Phase 2)
CACHE_ENABLED=true
CACHE_TTL_DEFAULT=300                   # 5 minutes default TTL
CACHE_TTL_PRODUCTS=600                  # 10 minutes for products
CACHE_TTL_CATEGORIES=1800               # 30 minutes for categories (rarely change)
CACHE_TTL_USERS=600                     # 10 minutes for users
CACHE_TTL_ANALYTICS=1800                # 30 minutes for analytics (expensive queries)

# ----------------------------------------------------------------------------
# RATE LIMITING CONFIGURATION - Phase 3 Optimization
# ----------------------------------------------------------------------------
# Role-based and endpoint-specific rate limiting
THROTTLE_TTL=60                         # Time window: 60 seconds
THROTTLE_LIMIT=100                      # Default limit: 100 requests/min

# Role-based limits (requests per minute)
THROTTLE_LIMIT_SUPER_ADMIN=10000        # Super admin: 10,000 req/min
THROTTLE_LIMIT_ADMIN=1000               # Admin: 1,000 req/min
THROTTLE_LIMIT_GROWER=200               # Grower: 200 req/min
THROTTLE_LIMIT_BUYER=150                # Buyer: 150 req/min
THROTTLE_LIMIT_USER=100                 # User: 100 req/min
THROTTLE_LIMIT_GUEST=20                 # Guest: 20 req/min

# Endpoint-specific limits
THROTTLE_LIMIT_EXPENSIVE=10             # Expensive endpoints (analytics): 10 req/min
THROTTLE_LIMIT_STANDARD=100             # Standard CRUD: 100 req/min
THROTTLE_LIMIT_CHEAP=1000               # Lightweight ops: 1000 req/min

# User quotas (daily/monthly limits)
QUOTA_ENABLED=true
QUOTA_DAILY_DEFAULT=10000               # 10,000 requests per day default
QUOTA_MONTHLY_DEFAULT=300000            # 300,000 requests per month default

# ----------------------------------------------------------------------------
# CSRF PROTECTION CONFIGURATION
# ----------------------------------------------------------------------------
# CSRF (Cross-Site Request Forgery) protection using Double Submit Cookie pattern
# Protects state-changing operations (POST, PUT, DELETE, PATCH) from unauthorized requests

# Enable/disable CSRF protection (enabled by default)
CSRF_ENABLED=true

# CSRF secret key for HMAC token generation
# IMPORTANT: Generate a strong random secret for production!
# Example: openssl rand -hex 32
CSRF_SECRET=your-csrf-secret-key-change-this-in-production

# Cookie and header names (optional, defaults provided)
# CSRF_TOKEN_COOKIE_NAME=XSRF-TOKEN
# CSRF_SECRET_COOKIE_NAME=_csrf_secret
# CSRF_HEADER_NAME=x-xsrf-token
# CSRF_BODY_FIELD_NAME=_csrf

# Paths excluded from CSRF protection (comma-separated)
# Public endpoints and webhooks typically don't need CSRF protection
# CSRF_EXCLUDED_PATHS=/api/v1/health,/api/v1/metrics,/api/v1/auth/login,/api/v1/auth/register,/api/v1/webhook

# ----------------------------------------------------------------------------
# ALERT SYSTEM CONFIGURATION
# ----------------------------------------------------------------------------
ALERT_QUEUE_CONCURRENCY=10              # Parallel alert processing
ALERT_MAX_RETRIES=3                     # Retry failed alerts 3 times
ALERT_COOLDOWN_MINUTES=15               # Wait 15min before re-alerting
ALERT_DEDUPLICATION_WINDOW_MINUTES=60   # Deduplicate within 60min window

# ----------------------------------------------------------------------------
# MONITORING & OBSERVABILITY - Phase 4 Complete
# ----------------------------------------------------------------------------
# Prometheus Metrics
METRICS_ENABLED=true
METRICS_PATH=/metrics

# OpenTelemetry Distributed Tracing
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=mash-backend
OTEL_SERVICE_VERSION=1.0.0

# Grafana Configuration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# Alertmanager Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=YOUR_EMAIL@gmail.com
SMTP_PASSWORD=YOUR_APP_SPECIFIC_PASSWORD
SMTP_FROM=YOUR_EMAIL@gmail.com

# Alert notification recipients
ALERT_EMAIL_ONCALL=oncall@yourdomain.com
ALERT_EMAIL_DEVOPS=devops@yourdomain.com
ALERT_EMAIL_DATABASE_TEAM=database-team@yourdomain.com
ALERT_EMAIL_PERFORMANCE_TEAM=performance-team@yourdomain.com

# Slack Alerting (Optional - Configure webhook URL)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# ----------------------------------------------------------------------------
# CORS CONFIGURATION
# ----------------------------------------------------------------------------
# Development: Automatically allows localhost variants
# Production: Comma-separated list of allowed origins
# 🌍 CORS Configuration
# Comma-separated list of allowed origins for Cross-Origin Resource Sharing (CORS)
# Update with your actual frontend URL(s) in production
CORS_ORIGINS=https://mash-backend-api.up.railway.app,http://localhost:4200,http://localhost:5173
CORS_CREDENTIALS=true

# ----------------------------------------------------------------------------
# MQTT CONFIGURATION - IoT Device Communication
# ----------------------------------------------------------------------------
MQTT_ENABLED=false
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=YOUR_MQTT_USERNAME
MQTT_PASSWORD=YOUR_MQTT_PASSWORD

# ----------------------------------------------------------------------------
# FILE UPLOAD CONFIGURATION
# ----------------------------------------------------------------------------
MAX_FILE_SIZE=10485760                  # 10MB max file size
UPLOAD_PATH=./uploads

# ----------------------------------------------------------------------------
# JWT CONFIGURATION - JSON Web Token Authentication
# ----------------------------------------------------------------------------
# CRITICAL: Change this secret in production! Use a strong 256+ bit key
# Generate with: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=1d

# Session configuration
SESSION_DURATION=7d                     # JWT token expiry: 7 days
REFRESH_TOKEN_DURATION=30d              # Refresh token expiry: 30 days
MAX_SESSIONS_PER_USER=5                 # Max concurrent sessions per user

# ----------------------------------------------------------------------------
# CLERK CONFIGURATION - Enterprise Authentication (Optional)
# ----------------------------------------------------------------------------
# Enable/disable Clerk authentication (false = use Firebase only)
CLERK_ENABLED=false

# Clerk API Keys (get from https://clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=YOUR_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=YOUR_CLERK_SECRET_KEY
CLERK_WEBHOOK_SECRET=YOUR_CLERK_WEBHOOK_SECRET
CLERK_JWT_KEY=YOUR_CLERK_JWT_KEY

# ----------------------------------------------------------------------------
# FRONTEND URLs - For redirects and CORS
# ----------------------------------------------------------------------------
# 🌐 Frontend Configuration
# Frontend URL for redirects, OAuth callbacks, and CORS (used by Clerk and other OAuth providers)
# Update this to your production frontend URL when deploying
FRONTEND_URL=https://mash-backend-api.up.railway.app
CLERK_AFTER_SIGN_IN_URL=/dashboard
CLERK_AFTER_SIGN_UP_URL=/onboarding

# ----------------------------------------------------------------------------
# WEBSOCKET CONFIGURATION - Real-time Communication
# ----------------------------------------------------------------------------
WS_PORT=3000                            # WebSocket server port (same as HTTP)
WS_NAMESPACE=/ws                        # Socket.IO namespace
# CORS Configuration (Allow multiple frontend origins)
# Comma-separated list of origins allowed to connect to the WebSocket server
# Update with your actual frontend URLs in production
WS_CORS_ORIGIN=https://mash-backend-api.up.railway.app,http://localhost:4200,http://localhost:5173
WS_PING_TIMEOUT=60000                   # 60 seconds
WS_PING_INTERVAL=25000                  # 25 seconds
WS_MAX_CONNECTIONS=10000                # Maximum concurrent connections
WS_REDIS_ADAPTER_ENABLED=false          # Enable Redis adapter for horizontal scaling
WS_COMPRESSION_ENABLED=true             # Enable WebSocket compression
WS_TRANSPORTS=websocket,polling         # Allowed transport methods

# ----------------------------------------------------------------------------
# AI/ML CONFIGURATION
# ----------------------------------------------------------------------------
# OpenAI API Key (for AI-powered features)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# ----------------------------------------------------------------------------
# ANALYTICS & BI CONFIGURATION - Issue #26
# ----------------------------------------------------------------------------
# Analytics Configuration
ANALYTICS_CACHE_TTL=900                  # 15 minutes cache for analytics
ANALYTICS_BATCH_ENABLED=true             # Enable batch processing for performance
ANALYTICS_REALTIME_ENABLED=true          # Enable real-time analytics updates
ANALYTICS_WEBSOCKET_PORT=3001            # WebSocket port for real-time analytics

# Export Configuration
EXPORT_S3_BUCKET=YOUR_S3_BUCKET_NAME     # S3 bucket for analytics exports
EXPORT_S3_REGION=us-east-1               # AWS region for S3
EXPORT_LOCAL_PATH=./uploads/exports      # Local path for export files
EXPORT_MAX_ROWS=100000                   # Maximum rows per export file

# Scheduled Reports
REPORTS_EMAIL_ENABLED=true               # Enable automated email reports
REPORTS_CRON_ENABLED=true                # Enable scheduled report generation

# ----------------------------------------------------------------------------
# AWS CONFIGURATION - For file uploads and exports
# ----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=us-east-1
AWS_S3_BUCKET=YOUR_S3_BUCKET_NAME

# ============================================================================
# END OF CONFIGURATION
# ============================================================================
# 
