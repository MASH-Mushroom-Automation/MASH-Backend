generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String               @id @default(cuid())
  clerkId              String               @unique
  email                String               @unique
  username             String?              @unique
  firstName            String?
  lastName             String?
  imageUrl             String?
  phoneNumber          String?
  role                 UserRole             @default(USER)
  isActive             Boolean              @default(true)
  preferences          Json? // User preferences (theme, language, timezone, notifications)
  twoFactorSecret      String? // TOTP secret (base32 encoded)
  twoFactorEnabled     Boolean              @default(false) // Whether 2FA is enabled
  twoFactorBackupCodes String[]             @default([]) // Hashed backup codes
  lastLoginAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  addresses            Address[]
  apiKeys              ApiKey[]
  devices              Device[]
  userNotifications    UserNotification[]   @relation("UserNotifications")
  orders               Order[]
  payments             Payment[]
  sensorData           SensorData[]
  sessions             Session[]
  userRoleAssignments  UserRoleAssignment[]

  // Alert System Relations
  alertRulesCreated     AlertRule[]            @relation("AlertRuleCreator")
  alertRulesUpdated     AlertRule[]            @relation("AlertRuleUpdater")
  alertRecipients       AlertRuleRecipient[]   @relation("AlertRecipient")
  alertAcknowledgments  AlertAcknowledgment[]  @relation("AlertAcknowledgmentUser")
  notificationTemplates NotificationTemplate[] @relation("NotificationTemplateCreator")
  alertNotifications    Notification[]

  // Import/Export System Relations
  importExportJobs ImportExportJob[] @relation("ImportExportJobsCreated")

  // Performance Indexes for analytics queries
  @@index([createdAt])
  @@index([isActive, role])
  @@index([lastLoginAt])
  @@index([email, isActive]) // Email lookup with active filter (Neon optimization)
  @@map("users")
}

model Device {
  id             String          @id @default(cuid())
  name           String
  type           DeviceType
  serialNumber   String          @unique
  status         DeviceStatus    @default(OFFLINE)
  userId         String
  location       String?
  description    String?
  firmware       String?
  ipAddress      String?
  macAddress     String?
  lastSeen       DateTime?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  alerts         SensorAlert[]
  deviceCommands DeviceCommand[]
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sensorData     SensorData[]
  sensors        Sensor[]

  // Performance Indexes (Task 1.2)
  @@index([userId, status, isActive])
  @@index([status, lastSeen(sort: Desc)])
  @@index([createdAt])
  @@index([isActive])
  @@map("devices")
}

model Sensor {
  id          String        @id @default(cuid())
  deviceId    String
  type        String
  name        String
  unit        String
  minValue    Float?
  maxValue    Float?
  calibration Json?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  alerts      SensorAlert[]
  sensorData  SensorData[]
  device      Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("sensors")
}

model SensorData {
  id        String   @id @default(cuid())
  deviceId  String
  sensorId  String?
  userId    String
  type      String
  value     Float
  unit      String
  quality   String?
  timestamp DateTime @default(now())
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  sensor    Sensor?  @relation(fields: [sensorId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deviceId, timestamp])
  @@index([type, timestamp])
  @@map("sensor_data")
}

model DeviceCommand {
  id             String    @id @default(cuid())
  deviceId       String
  command        String
  parameters     Json?
  status         String    @default("pending")
  response       Json?
  sentAt         DateTime  @default(now())
  acknowledgedAt DateTime?
  device         Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("device_commands")
}

model SensorAlert {
  id         String    @id @default(cuid())
  deviceId   String?
  sensorId   String?
  type       String
  severity   String
  title      String
  message    String
  threshold  Json?
  isActive   Boolean   @default(true)
  isResolved Boolean   @default(false)
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  device     Device?   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  sensor     Sensor?   @relation(fields: [sensorId], references: [id], onDelete: Cascade)

  @@map("sensor_alerts")
}

model Product {
  id             String      @id @default(cuid())
  name           String
  description    String?
  slug           String      @unique
  sku            String?     @unique
  price          Decimal     @db.Decimal(10, 2)
  comparePrice   Decimal?    @db.Decimal(10, 2)
  costPrice      Decimal?    @db.Decimal(10, 2)
  stock          Int         @default(0)
  minStock       Int         @default(0)
  weight         Float?
  dimensions     Json?
  images         Json[]
  categories     Json[]
  tags           Json[]
  attributes     Json?
  isActive       Boolean     @default(true)
  isFeatured     Boolean     @default(false)
  isDeleted      Boolean     @default(false) // Soft delete for archived products
  deletedAt      DateTime? // When product was archived
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  orderItems     OrderItem[]

  // Performance Indexes (Task 1.2)
  @@index([isActive, isFeatured, createdAt(sort: Desc)])
  @@index([slug, isActive])
  @@index([stock, minStock])
  @@index([createdAt])
  @@index([isDeleted, isActive]) // Soft delete filtering (Neon optimization)
  @@map("products")
}

model Category {
  id          String     @id @default(cuid())
  name        String
  description String?
  slug        String     @unique
  parentId    String?
  imageUrl    String?
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")

  // Performance Indexes (Task 1.2)
  @@index([isActive, sortOrder])
  @@index([parentId, isActive])
  @@index([createdAt])
  @@map("categories")
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String
  status          OrderStatus @default(PENDING)
  subtotal        Decimal     @db.Decimal(10, 2)
  tax             Decimal     @default(0) @db.Decimal(10, 2)
  shipping        Decimal     @default(0) @db.Decimal(10, 2)
  discount        Decimal     @default(0) @db.Decimal(10, 2)
  total           Decimal     @db.Decimal(10, 2)
  currency        String      @default("PHP")
  notes           String?
  shippingAddress Json
  billingAddress  Json
  trackingNumber  String?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  orderItems      OrderItem[]
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments        Payment[]

  // Performance Indexes (Task 1.2)
  @@index([userId, status, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([orderNumber])
  @@index([createdAt])
  @@index([deliveredAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  // Analytics indexes for product performance queries
  @@index([productId])
  @@index([orderId])
  @@index([productId, orderId])
  @@map("order_items")
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  type        String
  firstName   String
  lastName    String
  company     String?
  street1     String
  street2     String?
  city        String
  state       String
  postalCode  String
  country     String   @default("Philippines")
  phoneNumber String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String?
  userId          String
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("PHP")
  status          PaymentStatus @default(PENDING)
  method          PaymentMethod
  transactionId   String?       @unique
  gatewayResponse Json?
  processedAt     DateTime?
  failedAt        DateTime?
  refundedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  order           Order?        @relation(fields: [orderId], references: [id])
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Payment history index (Neon optimization)
  @@index([userId, status, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([transactionId])
  @@map("payments")
}

model UserNotification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_notifications")
}

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  category    String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, isPublic])
  @@index([key, isPublic])
  @@map("system_config")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  timestamp DateTime @default(now())

  @@index([userId, timestamp])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model Permission {
  id              String           @id @default(cuid())
  resource        String
  action          String
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@index([resource])
  @@index([action])
  @@map("permissions")
}

model Role {
  id                  String               @id @default(cuid())
  name                String               @unique
  description         String?
  isSystem            Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  rolePermissions     RolePermission[]
  userRoleAssignments UserRoleAssignment[]

  @@map("roles")
}

model UserRoleAssignment {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  grantedBy String?
  grantedAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_role_assignments")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Session {
  id             String        @id @default(cuid())
  userId         String
  clerkSessionId String?       @unique
  token          String        @unique
  status         SessionStatus @default(ACTIVE)
  deviceInfo     Json?
  ipAddress      String?
  userAgent      String?
  lastActivity   DateTime      @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  revokedReason  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([clerkSessionId])
  @@map("sessions")
}

model ApiKey {
  id            String    @id @default(cuid())
  userId        String
  name          String
  keyHash       String    @unique
  keyPrefix     String
  scopes        Json
  lastUsedAt    DateTime?
  expiresAt     DateTime?
  revokedAt     DateTime?
  revokedReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyPrefix])
  @@index([expiresAt])
  @@map("api_keys")
}

model SecurityLog {
  id        String   @id @default(cuid())
  userId    String?
  event     String
  severity  String
  ipAddress String?
  userAgent String?
  metadata  Json?
  timestamp DateTime @default(now())

  @@index([userId, timestamp])
  @@index([event])
  @@index([severity])
  @@index([timestamp])
  @@map("security_logs")
}

model RateLimitLog {
  id          String   @id @default(cuid())
  identifier  String
  endpoint    String
  count       Int      @default(1)
  windowStart DateTime
  windowEnd   DateTime
  blocked     Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([identifier, endpoint, windowStart])
  @@index([identifier, windowStart])
  @@index([endpoint])
  @@map("rate_limit_logs")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
  GROWER
  BUYER
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum DeviceType {
  MUSHROOM_CHAMBER
  ENVIRONMENTAL_SENSOR
  IRRIGATION_SYSTEM
  HVAC_CONTROLLER
  CAMERA
  pH_SENSOR
  HUMIDITY_CONTROLLER
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
  ERROR
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  PAYPAL
  GCASH
  MAYA
  BANK_TRANSFER
}

enum NotificationType {
  ALERT
  INFO
  WARNING
  SUCCESS
  DEVICE_STATUS
  ORDER_UPDATE
  PAYMENT_UPDATE
}

// ============================================
// ALERT & NOTIFICATION SYSTEM (Issue #10)
// ============================================

// Alert Categories
enum AlertCategory {
  SYSTEM // System-level alerts (CPU, memory, disk)
  SECURITY // Security-related alerts (unauthorized access, suspicious activity)
  BUSINESS // Business logic alerts (low inventory, high sales)
  USER // User-related alerts (account activity)
  SENSOR // IoT sensor alerts (temperature, humidity)
  ORDER // Order-related alerts (order delays, cancellations)
  PAYMENT // Payment-related alerts (failed payments, refunds)
}

// Alert Priority Levels
enum AlertPriority {
  CRITICAL // Requires immediate action
  HIGH // Requires prompt attention
  MEDIUM // Should be addressed soon
  LOW // Can be addressed when convenient
}

// Alert Status
enum AlertStatus {
  PENDING // Alert created, waiting to be sent
  SENT // Notifications sent
  ACKNOWLEDGED // User acknowledged the alert
  RESOLVED // Issue resolved
  ESCALATED // Alert escalated to higher level
  SNOOZED // Temporarily muted
  CANCELLED // Alert cancelled
}

// Notification Channel Types
enum NotificationChannel {
  EMAIL // Email notification
  SMS // SMS notification
  PUSH // Push notification (Firebase, OneSignal)
  IN_APP // In-app notification
  WEBHOOK // Webhook callback
}

// Notification Status
enum NotificationStatus {
  PENDING // Queued, not sent yet
  QUEUED // In processing queue
  SENDING // Currently being sent
  SENT // Successfully sent
  DELIVERED // Confirmed delivery (webhook callback)
  FAILED // Failed to send
  BOUNCED // Email bounced
  RETRYING // Retrying after failure
  CANCELLED // Cancelled before sending
}

// Recipient Types for Alert Rules
enum RecipientType {
  USER // Specific user by ID
  ROLE // All users with a specific role
  EMAIL // Direct email address
  PHONE // Direct phone number
}

// Acknowledgment Actions
enum AcknowledgmentAction {
  ACKNOWLEDGED // User acknowledged the alert
  RESOLVED // User marked as resolved
  ESCALATED // User escalated the alert
  SNOOZED // User snoozed the alert
  COMMENTED // User added a comment
  CANCELLED // User cancelled the alert
}

// ============================================
// 1. ALERT RULES - Define when alerts trigger
// ============================================
model AlertRule {
  id              String        @id @default(uuid())
  name            String // Rule name (e.g., "High Temperature Alert")
  description     String? // Detailed description
  category        AlertCategory // Alert category
  priority        AlertPriority // Alert priority
  eventType       String // Event type to monitor (e.g., "sensor.temperature")
  condition       Json // Condition to evaluate { operator: "GT", threshold: 30, field: "value" }
  activeHours     Json? // Active time window { start: "09:00", end: "17:00", days: [1,2,3,4,5] }
  cooldownMinutes Int           @default(15) // Cooldown period between alerts
  isActive        Boolean       @default(true)
  isDeleted       Boolean       @default(false)
  createdBy       String // User who created the rule
  updatedBy       String? // User who last updated
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  creator    User                 @relation("AlertRuleCreator", fields: [createdBy], references: [id])
  updater    User?                @relation("AlertRuleUpdater", fields: [updatedBy], references: [id])
  recipients AlertRuleRecipient[]
  alerts     Alert[]

  @@index([eventType])
  @@index([isActive])
  @@index([category, priority])
  @@index([createdBy]) // User's created rules (Neon optimization)
  @@map("alert_rules")
}

// ============================================
// 2. ALERT RULE RECIPIENTS - Who receives alerts
// ============================================
model AlertRuleRecipient {
  id            String        @id @default(uuid())
  ruleId        String // Alert rule
  recipientType RecipientType // Type of recipient
  recipientId   String? // User ID (if USER type)
  role          String? // Role name (if ROLE type)
  email         String? // Email address (if EMAIL type)
  phone         String? // Phone number (if PHONE type)

  // Channel preferences
  enableEmail Boolean @default(true)
  enableSms   Boolean @default(false)
  enablePush  Boolean @default(true)
  enableInApp Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  rule AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  user User?     @relation("AlertRecipient", fields: [recipientId], references: [id])

  @@index([ruleId])
  @@index([recipientId])
  @@map("alert_rule_recipients")
}

// ============================================
// 3. ALERTS - Alert instances when rules trigger
// ============================================
model Alert {
  id       String        @id @default(uuid())
  ruleId   String // Alert rule that triggered this
  title    String // Alert title
  message  String // Alert message
  category AlertCategory // Alert category
  priority AlertPriority // Alert priority
  severity Int           @default(5) // Severity score (1-10)
  status   AlertStatus   @default(PENDING)

  // Event Information
  eventType String // Event type (e.g., "sensor.temperature")
  eventId   String? // Original event ID
  eventData Json? // Event data snapshot

  // Deduplication & Grouping
  fingerprint     String // Unique fingerprint for deduplication
  groupKey        String? // Group similar alerts together
  occurrenceCount Int      @default(1) // Number of times this alert occurred
  firstOccurrence DateTime @default(now())
  lastOccurrence  DateTime @default(now())

  // Timing
  triggeredAt    DateTime  @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  escalatedAt    DateTime?
  snoozedUntil   DateTime?

  // Metadata
  metadata Json? // Additional metadata
  tags     String[] @default([]) // Tags for filtering

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  rule            AlertRule             @relation(fields: [ruleId], references: [id])
  notifications   Notification[]        @relation("AlertNotifications")
  acknowledgments AlertAcknowledgment[]

  @@index([ruleId])
  @@index([status])
  @@index([priority])
  @@index([fingerprint])
  @@index([triggeredAt])
  @@index([eventType, eventId])
  @@map("alerts")
}

// ============================================
// 4. NOTIFICATIONS - Notification delivery records
// ============================================
model Notification {
  id      String              @id @default(uuid())
  alertId String? // Alert that triggered this notification
  userId  String? // User receiving notification (for in-app)
  channel NotificationChannel // Delivery channel
  status  NotificationStatus  @default(PENDING)

  // Recipient Information
  recipientEmail String? // Email recipient
  recipientPhone String? // Phone recipient
  recipientId    String? // User ID recipient

  // Content
  subject    String? // Email subject / Push title
  body       String // Message body
  templateId String? // Template used (if any)

  // Delivery Tracking
  queuedAt    DateTime? // When added to queue
  sentAt      DateTime? // When sent
  deliveredAt DateTime? // When delivered (webhook confirmation)
  failedAt    DateTime? // When failed

  // Retry Logic
  retryCount  Int       @default(0)
  maxRetries  Int       @default(3)
  nextRetryAt DateTime? // When to retry next

  // Provider Details
  provider          String? // Provider used (SendGrid, Twilio, Firebase)
  providerMessageId String? // External message ID
  providerResponse  Json? // Provider response data
  errorMessage      String? // Error message if failed

  // Metadata
  metadata Json? // Additional metadata
  priority Int   @default(5) // Priority for queue processing

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  alert    Alert?                @relation("AlertNotifications", fields: [alertId], references: [id])
  user     User?                 @relation(fields: [userId], references: [id])
  template NotificationTemplate? @relation(fields: [templateId], references: [id])

  @@index([alertId])
  @@index([userId])
  @@index([status])
  @@index([channel])
  @@index([queuedAt])
  @@index([createdAt])
  // Performance Indexes (Task 1.2)
  @@index([userId, status, createdAt(sort: Desc)])
  @@index([status, priority, queuedAt])
  @@index([status, nextRetryAt])
  @@map("notifications")
}

// ============================================
// 5. ALERT ACKNOWLEDGMENTS - Alert action history
// ============================================
model AlertAcknowledgment {
  id        String               @id @default(uuid())
  alertId   String // Alert being acknowledged
  userId    String // User taking action
  action    AcknowledgmentAction // Action taken
  comment   String? // Optional comment
  metadata  Json? // Additional metadata
  createdAt DateTime             @default(now())

  // Relations
  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user  User  @relation("AlertAcknowledgmentUser", fields: [userId], references: [id])

  @@index([alertId])
  @@index([userId])
  @@map("alert_acknowledgments")
}

// ============================================
// 6. NOTIFICATION TEMPLATES - Reusable templates
// ============================================
model NotificationTemplate {
  id          String              @id @default(uuid())
  name        String              @unique // Template identifier
  description String? // Template description
  category    AlertCategory // Category this template is for
  channel     NotificationChannel // Channel type
  subject     String? // Email subject / Push title template
  body        String // Message body template (supports variables {{var}})
  variables   Json? // Expected variables { "sensorName": "Sensor name", "temperature": "Current temp" }
  isActive    Boolean             @default(true)
  createdBy   String // User who created
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  // Relations
  creator       User           @relation("NotificationTemplateCreator", fields: [createdBy], references: [id])
  notifications Notification[]

  @@index([name])
  @@index([category, channel])
  @@map("notification_templates")
}

// ============================================
// 7. ALERT ESCALATION POLICIES - Auto-escalation rules
// ============================================
model AlertEscalationPolicy {
  id                String          @id @default(uuid())
  name              String // Policy name
  description       String? // Policy description
  priority          AlertPriority[] // Alert priorities this applies to
  category          AlertCategory[] // Alert categories this applies to
  unacknowledgedMin Int             @default(30) // Minutes before escalation
  steps             Json // Escalation steps [{ level: 1, delay: 15, recipients: [...], channels: [...] }]
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([isActive])
  @@map("alert_escalation_policies")
}

