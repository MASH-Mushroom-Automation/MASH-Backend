generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                          String                 @id @default(cuid())
  clerkId                     String?                @unique
  email                       String                 @unique
  username                    String?                @unique
  firstName                   String?
  lastName                    String?
  imageUrl                    String?
  phoneNumber                 String?
  role                        UserRole               @default(USER)
  isActive                    Boolean                @default(true)
  lastLoginAt                 DateTime?
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt
  preferences                 Json?
  twoFactorBackupCodes        String[]               @default([])
  twoFactorEnabled            Boolean                @default(false)
  twoFactorSecret             String?
  password                    String?
  emailVerified               Boolean                @default(false)
  emailVerificationToken      String?
  emailVerificationExpiry     DateTime?
  emailVerificationAttempts   Int                    @default(0)
  emailVerificationCode       String?
  emailVerificationCodeExpiry DateTime?
  emailVerificationCodeSentAt DateTime?
  emailVerificationCodeUsed   Boolean                @default(false)
  facebookId                  String?                @unique
  googleId                    String?                @unique
  oauthAccessToken            String?
  oauthProvider               String[]               @default([])
  oauthRefreshToken           String?
  oauthTokenExpiry            DateTime?
  passwordResetAttempts       Int                    @default(0)
  passwordResetCode           String?
  passwordResetCodeExpiry     DateTime?
  passwordResetCodeSentAt     DateTime?
  passwordResetCodeUsed       Boolean                @default(false)
  addresses                   Address[]
  alertAcknowledgments        AlertAcknowledgment[]  @relation("AlertAcknowledgmentUser")
  alertRecipients             AlertRuleRecipient[]   @relation("AlertRecipient")
  alertRulesCreated           AlertRule[]            @relation("AlertRuleCreator")
  alertRulesUpdated           AlertRule[]            @relation("AlertRuleUpdater")
  apiKeys                     ApiKey[]
  apiUsageLogs                ApiUsageLog[]
  apiVersionUsage             ApiVersionUsage[]
  carts                       Cart[]
  devices                     Device[]
  importExportJobs            ImportExportJob[]      @relation("ImportExportJobsCreated")
  notificationTemplates       NotificationTemplate[] @relation("NotificationTemplateCreator")
  alertNotifications          Notification[]
  orders                      Order[]
  payments                    Payment[]
  pushSubscriptions           PushSubscription[]
  rateLimitOverrides          RateLimitOverride[]
  requestQueues               RequestQueue[]
  sensorData                  SensorData[]
  sessions                    Session[]
  userNotifications           UserNotification[]     @relation("UserNotifications")
  userRoleAssignments         UserRoleAssignment[]

  @@index([createdAt])
  @@index([isActive, role])
  @@index([lastLoginAt])
  @@index([email, isActive])
  @@index([emailVerificationToken])
  @@index([email, emailVerified])
  @@index([email, emailVerificationCode])
  @@index([emailVerificationCode, emailVerificationCodeExpiry])
  @@index([email, passwordResetCode])
  @@index([passwordResetCode, passwordResetCodeExpiry])
  @@index([googleId])
  @@index([facebookId])
  @@index([oauthProvider])
  @@map("users")
}

model Device {
  id                String             @id @default(cuid())
  name              String
  type              DeviceType
  serialNumber      String             @unique
  status            DeviceStatus       @default(OFFLINE)
  userId            String?
  location          String?
  description       String?
  firmware          String?
  ipAddress         String?
  macAddress        String?
  lastSeen          DateTime?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deviceCommands    DeviceCommand[]
  healthRecords     DeviceHealth[]
  user              User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushSubscriptions PushSubscription[]
  alerts            SensorAlert[]
  sensorData        SensorData[]
  sensors           Sensor[]

  @@index([userId, status, isActive])
  @@index([status, lastSeen(sort: Desc)])
  @@index([createdAt])
  @@index([isActive])
  @@map("devices")
}

model Sensor {
  id          String        @id @default(cuid())
  deviceId    String
  type        String
  name        String
  unit        String
  minValue    Float?
  maxValue    Float?
  calibration Json?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  alerts      SensorAlert[]
  sensorData  SensorData[]
  device      Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("sensors")
}

model SensorData {
  id        String   @id @default(cuid())
  deviceId  String
  sensorId  String?
  userId    String
  type      String
  value     Float
  unit      String
  quality   String?
  timestamp DateTime @default(now())
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  sensor    Sensor?  @relation(fields: [sensorId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deviceId, timestamp])
  @@index([type, timestamp])
  @@map("sensor_data")
}

model DeviceCommand {
  id             String    @id @default(cuid())
  deviceId       String
  command        String
  parameters     Json?
  status         String    @default("pending")
  response       Json?
  sentAt         DateTime  @default(now())
  acknowledgedAt DateTime?
  device         Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("device_commands")
}

model SensorAlert {
  id         String    @id @default(cuid())
  deviceId   String?
  sensorId   String?
  type       String
  severity   String
  title      String
  message    String
  threshold  Json?
  isActive   Boolean   @default(true)
  isResolved Boolean   @default(false)
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  device     Device?   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  sensor     Sensor?   @relation(fields: [sensorId], references: [id], onDelete: Cascade)

  @@map("sensor_alerts")
}

model Product {
  id             String      @id @default(cuid())
  name           String
  description    String?
  slug           String      @unique
  sku            String?     @unique
  price          Decimal     @db.Decimal(10, 2)
  comparePrice   Decimal?    @db.Decimal(10, 2)
  costPrice      Decimal?    @db.Decimal(10, 2)
  stock          Int         @default(0)
  minStock       Int         @default(0)
  maxCartQty     Int?        @default(100)
  weight         Float?
  dimensions     Json?
  images         Json[]
  categories     Json[]
  tags           Json[]
  attributes     Json?
  isActive       Boolean     @default(true)
  isFeatured     Boolean     @default(false)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?
  isDeleted      Boolean     @default(false)
  cartItems      CartItem[]
  orderItems     OrderItem[]

  @@index([isActive, isFeatured, createdAt(sort: Desc)])
  @@index([slug, isActive])
  @@index([stock, minStock])
  @@index([createdAt])
  @@index([isDeleted, isActive])
  @@map("products")
}

model Category {
  id          String     @id @default(cuid())
  name        String
  description String?
  slug        String     @unique
  parentId    String?
  imageUrl    String?
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")

  @@index([isActive, sortOrder])
  @@index([parentId, isActive])
  @@index([createdAt])
  @@map("categories")
}

model Cart {
  id             String     @id @default(cuid())
  userId         String?
  sessionId      String?
  status         CartStatus @default(ACTIVE)
  subtotal       Decimal    @default(0) @db.Decimal(10, 2)
  tax            Decimal    @default(0) @db.Decimal(10, 2)
  shipping       Decimal    @default(0) @db.Decimal(10, 2)
  discount       Decimal    @default(0) @db.Decimal(10, 2)
  total          Decimal    @default(0) @db.Decimal(10, 2)
  metadata       Json?
  lastActivityAt DateTime   @default(now())
  expiresAt      DateTime?
  abandonedAt    DateTime?
  convertedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user           User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          CartItem[]

  @@index([userId, status])
  @@index([sessionId, status])
  @@index([status, lastActivityAt])
  @@index([createdAt])
  @@map("carts")
}

model CartItem {
  id              String   @id @default(cuid())
  cartId          String
  productId       String
  quantity        Int
  price           Decimal  @db.Decimal(10, 2)
  originalPrice   Decimal  @db.Decimal(10, 2)
  subtotal          Decimal  @db.Decimal(10, 2)
  discount          Decimal  @default(0) @db.Decimal(10, 2)
  total             Decimal  @db.Decimal(10, 2)
  isAvailable       Boolean  @default(true)
  unavailableReason String?
  productSnapshot   Json?
  customization   Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  cart            Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String
  status          OrderStatus @default(PENDING)
  subtotal        Decimal     @db.Decimal(10, 2)
  tax             Decimal     @default(0) @db.Decimal(10, 2)
  shipping        Decimal     @default(0) @db.Decimal(10, 2)
  discount        Decimal     @default(0) @db.Decimal(10, 2)
  total           Decimal     @db.Decimal(10, 2)
  currency        String      @default("PHP")
  notes           String?
  shippingAddress Json
  billingAddress  Json
  trackingNumber  String?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  orderItems      OrderItem[]
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments        Payment[]

  @@index([userId, status, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([orderNumber])
  @@index([createdAt])
  @@index([deliveredAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([orderId])
  @@index([productId, orderId])
  @@map("order_items")
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  type        String
  firstName   String
  lastName    String
  company     String?
  street1     String
  street2     String?
  city        String
  state       String
  postalCode  String
  country     String   @default("Philippines")
  phoneNumber String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String?
  userId          String
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("PHP")
  status          PaymentStatus @default(PENDING)
  method          PaymentMethod
  transactionId   String?       @unique
  gatewayResponse Json?
  processedAt     DateTime?
  failedAt        DateTime?
  refundedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  order           Order?        @relation(fields: [orderId], references: [id])
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([transactionId])
  @@map("payments")
}

model UserNotification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_notifications")
}

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  category    String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, isPublic])
  @@index([key, isPublic])
  @@map("system_config")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  timestamp DateTime @default(now())

  @@index([userId, timestamp])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model Permission {
  id              String           @id @default(cuid())
  resource        String
  action          String
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@index([resource])
  @@index([action])
  @@map("permissions")
}

model Role {
  id                  String               @id @default(cuid())
  name                String               @unique
  description         String?
  isSystem            Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  rolePermissions     RolePermission[]
  userRoleAssignments UserRoleAssignment[]

  @@map("roles")
}

model UserRoleAssignment {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  grantedBy String?
  grantedAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_role_assignments")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Session {
  id             String        @id @default(cuid())
  userId         String
  clerkSessionId String?       @unique
  token          String        @unique
  status         SessionStatus @default(ACTIVE)
  deviceInfo     Json?
  ipAddress      String?
  userAgent      String?
  lastActivity   DateTime      @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  revokedReason  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([clerkSessionId])
  @@map("sessions")
}

model ApiKey {
  id            String    @id @default(cuid())
  userId        String
  name          String
  keyHash       String    @unique
  keyPrefix     String
  scopes        Json
  lastUsedAt    DateTime?
  expiresAt     DateTime?
  revokedAt     DateTime?
  revokedReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyPrefix])
  @@index([expiresAt])
  @@map("api_keys")
}

model SecurityLog {
  id        String   @id @default(cuid())
  userId    String?
  event     String
  severity  String
  ipAddress String?
  userAgent String?
  metadata  Json?
  timestamp DateTime @default(now())

  @@index([userId, timestamp])
  @@index([event])
  @@index([severity])
  @@index([timestamp])
  @@map("security_logs")
}

model RateLimitLog {
  id          String   @id @default(cuid())
  identifier  String
  endpoint    String
  count       Int      @default(1)
  windowStart DateTime
  windowEnd   DateTime
  blocked     Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([identifier, endpoint, windowStart])
  @@index([identifier, windowStart])
  @@index([endpoint])
  // 🚀 PERFORMANCE OPTIMIZATION: Composite indexes for fast lookups (targeting 215ms → <10ms)
  @@index([identifier, blocked, windowStart], name: "idx_identifier_blocked_window")
  @@index([identifier, windowStart, windowEnd], name: "idx_identifier_window_range")
  @@index([endpoint, blocked, windowStart], name: "idx_endpoint_blocked_window")
  @@index([blocked, createdAt], name: "idx_blocked_created")
  @@map("rate_limit_logs")
}

model AlertRule {
  id              String               @id @default(uuid())
  name            String
  description     String?
  category        AlertCategory
  priority        AlertPriority
  eventType       String
  condition       Json
  activeHours     Json?
  cooldownMinutes Int                  @default(15)
  isActive        Boolean              @default(true)
  isDeleted       Boolean              @default(false)
  createdBy       String
  updatedBy       String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  recipients      AlertRuleRecipient[]
  creator         User                 @relation("AlertRuleCreator", fields: [createdBy], references: [id])
  updater         User?                @relation("AlertRuleUpdater", fields: [updatedBy], references: [id])
  alerts          Alert[]

  @@index([eventType])
  @@index([isActive])
  @@index([category, priority])
  @@index([createdBy])
  @@map("alert_rules")
}

model AlertRuleRecipient {
  id            String        @id @default(uuid())
  ruleId        String
  recipientType RecipientType
  recipientId   String?
  role          String?
  email         String?
  phone         String?
  enableEmail   Boolean       @default(true)
  enableSms     Boolean       @default(false)
  enablePush    Boolean       @default(true)
  enableInApp   Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User?         @relation("AlertRecipient", fields: [recipientId], references: [id])
  rule          AlertRule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([recipientId])
  @@map("alert_rule_recipients")
}

model Alert {
  id              String                @id @default(uuid())
  title           String
  message         String
  resolvedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  acknowledgedAt  DateTime?
  category        AlertCategory
  escalatedAt     DateTime?
  eventData       Json?
  eventId         String?
  eventType       String
  fingerprint     String
  firstOccurrence DateTime              @default(now())
  groupKey        String?
  lastOccurrence  DateTime              @default(now())
  metadata        Json?
  occurrenceCount Int                   @default(1)
  priority        AlertPriority
  ruleId          String
  snoozedUntil    DateTime?
  status          AlertStatus           @default(PENDING)
  tags            String[]              @default([])
  triggeredAt     DateTime              @default(now())
  severity        Int                   @default(5)
  acknowledgments AlertAcknowledgment[]
  rule            AlertRule             @relation(fields: [ruleId], references: [id])
  notifications   Notification[]        @relation("AlertNotifications")

  @@index([ruleId])
  @@index([status])
  @@index([priority])
  @@index([fingerprint])
  @@index([triggeredAt])
  @@index([eventType, eventId])
  @@map("alerts")
}

model Notification {
  id                String                @id @default(uuid())
  userId            String?
  createdAt         DateTime              @default(now())
  alertId           String?
  body              String
  channel           NotificationChannel
  deliveredAt       DateTime?
  errorMessage      String?
  failedAt          DateTime?
  maxRetries        Int                   @default(3)
  metadata          Json?
  nextRetryAt       DateTime?
  priority          Int                   @default(5)
  provider          String?
  providerMessageId String?
  providerResponse  Json?
  queuedAt          DateTime?
  recipientEmail    String?
  recipientId       String?
  recipientPhone    String?
  retryCount        Int                   @default(0)
  sentAt            DateTime?
  status            NotificationStatus    @default(PENDING)
  subject           String?
  templateId        String?
  updatedAt         DateTime              @updatedAt
  alert             Alert?                @relation("AlertNotifications", fields: [alertId], references: [id])
  template          NotificationTemplate? @relation(fields: [templateId], references: [id])
  user              User?                 @relation(fields: [userId], references: [id])

  @@index([alertId])
  @@index([userId])
  @@index([status])
  @@index([channel])
  @@index([queuedAt])
  @@index([createdAt])
  @@index([userId, status, createdAt(sort: Desc)])
  @@index([status, priority, queuedAt])
  @@index([status, nextRetryAt])
  @@map("notifications")
}

model AlertAcknowledgment {
  id        String               @id @default(uuid())
  alertId   String
  userId    String
  action    AcknowledgmentAction
  comment   String?
  metadata  Json?
  createdAt DateTime             @default(now())
  alert     Alert                @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user      User                 @relation("AlertAcknowledgmentUser", fields: [userId], references: [id])

  @@index([alertId])
  @@index([userId])
  @@map("alert_acknowledgments")
}

model NotificationTemplate {
  id            String              @id @default(uuid())
  name          String              @unique
  description   String?
  category      AlertCategory
  channel       NotificationChannel
  subject       String?
  body          String
  variables     Json?
  isActive      Boolean             @default(true)
  createdBy     String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  creator       User                @relation("NotificationTemplateCreator", fields: [createdBy], references: [id])
  notifications Notification[]

  @@index([name])
  @@index([category, channel])
  @@map("notification_templates")
}

model AlertEscalationPolicy {
  id                String          @id @default(uuid())
  name              String
  description       String?
  priority          AlertPriority[]
  category          AlertCategory[]
  unacknowledgedMin Int             @default(30)
  steps             Json
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([isActive])
  @@map("alert_escalation_policies")
}

model Report {
  id            String               @id @default(uuid())
  name          String
  description   String?
  type          ReportType
  configuration Json
  schedule      Json?
  isActive      Boolean              @default(true)
  createdBy     String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  executions    ReportExecution[]
  subscriptions ReportSubscription[]

  @@index([type])
  @@index([createdBy])
  @@index([isActive, type])
  @@map("reports")
}

model ReportExecution {
  id           String          @id @default(uuid())
  reportId     String
  status       ExecutionStatus @default(PENDING)
  startedAt    DateTime        @default(now())
  completedAt  DateTime?
  duration     Int?
  resultData   Json?
  resultUrl    String?
  errorMessage String?
  executedBy   String?
  report       Report          @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([status])
  @@index([startedAt])
  @@index([reportId, status])
  @@map("report_executions")
}

model ReportSubscription {
  id         String                @id @default(uuid())
  reportId   String
  userId     String
  channel    NotificationChannel
  frequency  SubscriptionFrequency
  isActive   Boolean               @default(true)
  lastSentAt DateTime?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  report     Report                @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, userId, channel])
  @@index([reportId])
  @@index([userId])
  @@index([isActive, frequency])
  @@map("report_subscriptions")
}

model SearchLog {
  id            String   @id @default(cuid())
  query         String
  index         String
  resultsCount  Int
  took          Int
  filters       Json?
  sort          Json?
  userId        String?
  ipAddress     String?
  userAgent     String?
  clickedResult String?
  isSlowQuery   Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([query])
  @@index([createdAt])
  @@index([isSlowQuery, took])
  @@index([userId, createdAt])
  @@index([index, createdAt])
  @@map("search_logs")
}

model ImportExportJob {
  id               String              @id @default(cuid())
  type             JobType
  entityType       EntityType
  status           JobStatus
  priority         JobPriority
  fileName         String
  fileFormat       FileFormat
  fileSize         Int
  fileUrl          String?
  resultFileUrl    String?
  totalRecords     Int                 @default(0)
  processedRecords Int                 @default(0)
  successCount     Int                 @default(0)
  failureCount     Int                 @default(0)
  warningCount     Int                 @default(0)
  progressPercent  Float               @default(0)
  startedAt        DateTime?
  completedAt      DateTime?
  estimatedTimeMs  Int?
  options          Json?
  filters          Json?
  createdBy        String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  errors           ImportExportError[]
  createdByUser    User                @relation("ImportExportJobsCreated", fields: [createdBy], references: [id])

  @@index([status, createdAt])
  @@index([entityType, type])
  @@index([createdBy])
  @@map("import_export_jobs")
}

model ImportExportError {
  id             String          @id @default(cuid())
  jobId          String
  rowNumber      Int?
  columnName     String?
  fieldPath      String?
  errorType      ErrorType
  severity       ErrorSeverity
  errorCode      String
  message        String
  suggestion     String?
  originalValue  String?
  expectedFormat String?
  createdAt      DateTime        @default(now())
  job            ImportExportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, severity])
  @@map("import_export_errors")
}

model ImportExportTemplate {
  id          String     @id @default(cuid())
  name        String
  description String?
  entityType  EntityType
  fileFormat  FileFormat
  headers     Json
  sampleData  Json
  validation  Json
  isActive    Boolean    @default(true)
  createdBy   String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([entityType, fileFormat])
  @@map("import_export_templates")
}

model ApiGatewayConfig {
  id             String                @id @default(cuid())
  serviceName    String                @unique
  basePath       String
  targetUrl      String
  healthCheckUrl String?
  timeout        Int                   @default(30000)
  retryAttempts  Int                   @default(3)
  circuitBreaker Boolean               @default(true)
  loadBalancing  LoadBalancingStrategy @default(ROUND_ROBIN)
  isActive       Boolean               @default(true)
  priority       Int                   @default(0)
  metadata       Json?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@map("api_gateway_configs")
}

model RateLimitOverride {
  id           String            @id @default(cuid())
  userId       String?
  apiKey       String?
  endpoint     String
  requestLimit Int
  timeWindowMs Int
  strategy     RateLimitStrategy @default(TOKEN_BUCKET)
  priority     Int               @default(0)
  reason       String?
  expiresAt    DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User?             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([apiKey])
  @@index([endpoint])
  @@map("rate_limit_overrides")
}

model ApiUsageLog {
  id           String   @id @default(cuid())
  userId       String?
  apiKey       String?
  endpoint     String
  method       String
  version      String
  statusCode   Int
  responseTime Int
  requestSize  Int?
  responseSize Int?
  ipAddress    String
  userAgent    String?
  referer      String?
  rateLimitHit Boolean  @default(false)
  throttled    Boolean  @default(false)
  queueTime    Int?
  metadata     Json?
  timestamp    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id])

  @@index([userId, timestamp])
  @@index([endpoint, timestamp])
  @@index([timestamp])
  @@index([apiKey])
  @@map("api_usage_logs")
}

model RequestQueue {
  id              String             @id @default(cuid())
  userId          String?
  endpoint        String
  method          String
  priority        Int                @default(50)
  payload         Json?
  headers         Json?
  status          RequestQueueStatus @default(PENDING)
  estimatedWaitMs Int?
  queuedAt        DateTime           @default(now())
  processedAt     DateTime?
  completedAt     DateTime?
  expiresAt       DateTime
  retryCount      Int                @default(0)
  errorMessage    String?
  user            User?              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, priority, queuedAt])
  @@index([userId])
  @@index([expiresAt])
  @@map("request_queues")
}

model ApiVersionUsage {
  id           String   @id @default(cuid())
  version      String
  endpoint     String
  userId       String?
  requestCount Int      @default(1)
  lastUsedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User?    @relation(fields: [userId], references: [id])

  @@unique([version, endpoint, userId])
  @@index([version])
  @@index([userId])
  @@map("api_version_usage")
}

model CircuitBreakerState {
  id            String                  @id @default(cuid())
  serviceName   String                  @unique
  state         CircuitBreakerStateEnum @default(CLOSED)
  failureCount  Int                     @default(0)
  successCount  Int                     @default(0)
  lastFailureAt DateTime?
  lastSuccessAt DateTime?
  nextRetryAt   DateTime?
  openedAt      DateTime?
  metadata      Json?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([state])
  @@map("circuit_breaker_states")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  deviceId  String?
  endpoint  String   @unique
  keys      Json
  userAgent String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  device    Device?  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@index([isActive])
  @@map("push_subscriptions")
}

model DeviceHealth {
  id             String             @id @default(uuid())
  deviceId       String
  timestamp      DateTime           @default(now())
  status         DeviceHealthStatus
  cpuUsage       Float?
  memoryUsage    Float?
  diskUsage      Float?
  temperature    Float?
  batteryLevel   Float?
  networkLatency Int?
  uptime         Int?
  errorCount     Int                @default(0)
  metadata       Json?
  createdAt      DateTime           @default(now())
  device         Device             @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, timestamp(sort: Desc)])
  @@index([status])
  @@index([timestamp])
  @@map("device_health")
}

