// ============================================
// 8. ANALYTICS & REPORTING MODELS
// ============================================
model Report {
  id            String     @id @default(uuid())
  name          String // Report name
  description   String? // Report description
  type          ReportType // Report type (sales, users, products, etc.)
  configuration Json // Report configuration (filters, grouping, etc.)
  schedule      Json? // Schedule configuration for automated reports
  isActive      Boolean    @default(true)
  createdBy     String // User who created the report
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Relations
  executions    ReportExecution[]
  subscriptions ReportSubscription[]

  @@index([type])
  @@index([createdBy])
  @@index([isActive, type])
  @@map("reports")
}

model ReportExecution {
  id           String          @id @default(uuid())
  reportId     String // Report being executed
  status       ExecutionStatus @default(PENDING)
  startedAt    DateTime        @default(now())
  completedAt  DateTime? // When execution completed
  duration     Int? // Execution time in milliseconds
  resultData   Json? // Execution result data
  resultUrl    String? // URL to exported file (if applicable)
  errorMessage String? // Error message if failed
  executedBy   String? // User who triggered (null for scheduled)

  // Relations
  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([status])
  @@index([startedAt])
  @@index([reportId, status])
  @@map("report_executions")
}

model ReportSubscription {
  id         String                @id @default(uuid())
  reportId   String // Report being subscribed to
  userId     String // Subscriber user
  channel    NotificationChannel // Delivery channel
  frequency  SubscriptionFrequency // How often to receive
  isActive   Boolean               @default(true)
  lastSentAt DateTime? // Last time report was sent
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  // Relations
  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, userId, channel])
  @@index([reportId])
  @@index([userId])
  @@index([isActive, frequency])
  @@map("report_subscriptions")
}

// ============================================
// ANALYTICS ENUMS
// ============================================
enum ReportType {
  SALES
  REVENUE
  USERS
  PRODUCTS
  ORDERS
  DEVICES
  CUSTOM
}

enum ExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum SubscriptionFrequency {
  DAILY
  WEEKLY
  MONTHLY
  REAL_TIME
}

// ============================================
// SEARCH ANALYTICS
// ============================================

model SearchLog {
  id            String   @id @default(cuid())
  query         String // The search query string
  index         String // Which index was searched (products, orders, etc.)
  resultsCount  Int // Number of results returned
  took          Int // Query time in milliseconds
  filters       Json? // Applied filters (price, category, etc.)
  sort          Json? // Sort configuration
  userId        String? // User ID if authenticated search
  ipAddress     String? // IP address for rate limiting/analytics
  userAgent     String? // Browser/client info
  clickedResult String? // Product ID if user clicked a result
  isSlowQuery   Boolean  @default(false) // Flag for queries >500ms
  createdAt     DateTime @default(now())

  // Indexes for analytics queries
  @@index([query]) // Popular searches
  @@index([createdAt]) // Time-based analytics
  @@index([isSlowQuery, took]) // Slow query analysis
  @@index([userId, createdAt]) // User search history
  @@index([index, createdAt]) // Index-specific analytics
  @@map("search_logs")
}

// ============================================
// IMPORT/EXPORT SYSTEM
// ============================================

model ImportExportJob {
  id         String      @id @default(cuid())
  type       JobType // IMPORT | EXPORT
  entityType EntityType // PRODUCT | ORDER | USER | CATEGORY | etc.
  status     JobStatus // QUEUED | PROCESSING | COMPLETED | FAILED | CANCELLED
  priority   JobPriority // URGENT | NORMAL | LOW

  // File information
  fileName      String
  fileFormat    FileFormat // CSV | EXCEL | JSON | XML
  fileSize      Int // in bytes
  fileUrl       String? // S3/MinIO URL
  resultFileUrl String? // For exports

  // Progress tracking
  totalRecords     Int   @default(0)
  processedRecords Int   @default(0)
  successCount     Int   @default(0)
  failureCount     Int   @default(0)
  warningCount     Int   @default(0)
  progressPercent  Float @default(0)

  // Timing
  startedAt       DateTime?
  completedAt     DateTime?
  estimatedTimeMs Int?

  // Configuration
  options Json? // Import/export options (delimiter, skipRows, etc.)
  filters Json? // Export filters

  // Error tracking
  errors ImportExportError[]

  // Audit
  createdBy     String
  createdByUser User     @relation("ImportExportJobsCreated", fields: [createdBy], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, createdAt])
  @@index([entityType, type])
  @@index([createdBy])
  @@map("import_export_jobs")
}

model ImportExportError {
  id    String          @id @default(cuid())
  jobId String
  job   ImportExportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // Error location
  rowNumber  Int? // Row in file (1-indexed)
  columnName String?
  fieldPath  String? // For nested JSON/XML

  // Error details
  errorType  ErrorType // VALIDATION | CONSTRAINT | FORMAT | BUSINESS_RULE
  severity   ErrorSeverity // ERROR | WARNING
  errorCode  String // E.g., "REQUIRED_FIELD_MISSING"
  message    String
  suggestion String? // How to fix

  // Original data
  originalValue  String?
  expectedFormat String?

  createdAt DateTime @default(now())

  @@index([jobId, severity])
  @@map("import_export_errors")
}

model ImportExportTemplate {
  id          String     @id @default(cuid())
  name        String
  description String?
  entityType  EntityType
  fileFormat  FileFormat

  // Template configuration
  headers    Json // Column names and order
  sampleData Json // Example rows
  validation Json // Validation rules

  isActive  Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityType, fileFormat])
  @@map("import_export_templates")
}

// Enums for Import/Export System
enum JobType {
  IMPORT
  EXPORT
}

enum EntityType {
  PRODUCT
  ORDER
  USER
  CATEGORY
  SELLER
  BUYER
  TRANSACTION
  INVENTORY
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum JobPriority {
  URGENT
  NORMAL
  LOW
}

enum FileFormat {
  CSV
  EXCEL
  JSON
  XML
}

enum ErrorType {
  VALIDATION
  CONSTRAINT
  FORMAT
  BUSINESS_RULE
}

enum ErrorSeverity {
  ERROR
  WARNING
}
