    "item": [
        {
            "name": "Support Tickets",
            "item": [
                {
                    "name": "Create Support Ticket",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{ecommerce_accessToken}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"subject\": \"Product Quality Issue\",\n    \"description\": \"I received my mushroom order but some items were damaged during shipping. Can you help me with a refund or replacement?\",\n    \"category\": \"order_issue\",\n    \"priority\": \"medium\",\n    \"orderId\": \"{{orderId}}\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/ecommerce/support/tickets",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "ecommerce",
                                "support",
                                "tickets"
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Get User Support Tickets",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{ecommerce_accessToken}}"
