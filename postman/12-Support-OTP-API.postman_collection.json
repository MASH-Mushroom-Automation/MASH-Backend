                    "response": []
                },
                {
                    "name": "Add Ticket Response",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{ecommerce_accessToken}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"message\": \"Thank you for bringing this to our attention. I've processed a full refund for your order and it should appear in your account within 3-5 business days.\",\n    \"isInternal\": false\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/ecommerce/support/tickets/{{ticketId}}/responses",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
