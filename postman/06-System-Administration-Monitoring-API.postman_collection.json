    {
      "name": "Analytics and Tracking",
      "description": "System analytics, event tracking, and usage monitoring",
      "item": [
        {
          "name": "Track Analytics Event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"user_login\",\n  \"properties\": {\n    \"userId\": 123,\n    \"email\": \"user@example.com\",\n    \"loginMethod\": \"email_password\",\n    \"deviceType\": \"desktop\",\n    \"browser\": \"Chrome\",\n    \"ipAddress\": \"192.168.1.100\",\n    \"userAgent\": \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36\"\n  },\n  \"timestamp\": \"2024-01-15T10:30:00Z\",\n  \"platform\": \"web\",\n  \"sessionId\": \"sess_abc123xyz\",\n  \"metadata\": {\n    \"source\": \"login_form\",\n    \"campaign\": \"Q1_2024\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/analytics/track",
              "host": ["{{base_url}}"],
              "path": ["api", "analytics", "track"]
            },
            "description": "Records analytics events for user behavior tracking, system usage monitoring, and business intelligence collection."
          },
          "response": []
        },
        {
          "name": "Get Analytics Data",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/analytics/?eventType={{event_type}}&startDate={{start_date}}&endDate={{end_date}}&userId={{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "analytics"],
              "query": [
                {
                  "key": "eventType",
                  "value": "{{event_type}}",
                  "description": "Filter by specific event type"
                },
                {
                  "key": "startDate",
                  "value": "{{start_date}}",
                  "description": "Start date for analytics data range"
                },
                {
                  "key": "endDate",
                  "value": "{{end_date}}",
                  "description": "End date for analytics data range"
                },
                {
                  "key": "userId",
                  "value": "{{user_id}}",
                  "description": "Filter by specific user ID"
                }
              ]
            },
            "description": "Retrieves analytics data with filtering options for events, date ranges, and user-specific analysis."
          },
          "response": []
        },
        {
          "name": "Generate Analytics Report",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reportType\": \"USER_ACTIVITY_SUMMARY\",\n  \"dateRange\": {\n    \"startDate\": \"2024-01-01\",\n    \"endDate\": \"2024-01-31\"\n  },\n  \"filters\": {\n    \"eventTypes\": [\"user_login\", \"employee_created\", \"attendance_recorded\"],\n    \"userRoles\": [\"Admin\", \"Manager\"],\n    \"departments\": [\"HR\", \"IT\"]\n  },\n  \"metrics\": [\n    \"total_events\",\n    \"unique_users\",\n    \"session_duration\",\n    \"feature_usage\",\n    \"error_rates\"\n  ],\n  \"format\": \"JSON\",\n  \"includeCharts\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/analytics/reports/generate",
              "host": ["{{base_url}}"],
              "path": ["api", "analytics", "reports", "generate"]
            },
            "description": "Generates comprehensive analytics reports with customizable metrics, filters, and date ranges for business intelligence and system optimization."
          },
          "response": []
        }
