                            "raw": "{\n    \"name\": \"Mushroom Season Sale\",\n    \"subject\": \"Fresh Mushrooms - 20% Off This Week!\",\n    \"content\": \"<h1>Don't miss our amazing mushroom sale!</h1><p>Get 20% off all mushroom products this week only.</p>\",\n    \"targetAudience\": \"all_customers\",\n    \"scheduleDate\": \"2024-12-01T10:00:00Z\",\n    \"status\": \"scheduled\"\n}"
