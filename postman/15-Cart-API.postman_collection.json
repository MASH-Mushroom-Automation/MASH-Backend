								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"address\": {\n    \"region\": \"NCR\",\n    \"province\": \"Metro Manila\",\n    \"city\": \"Quezon City\",\n    \"barangay\": \"Commonwealth\",\n    \"addressLine1\": \"123 Main Street\",\n    \"postalCode\": \"1121\"\n  }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/cart/shipping/estimate",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"cart",
								"shipping",
								"estimate"
							]
						},
