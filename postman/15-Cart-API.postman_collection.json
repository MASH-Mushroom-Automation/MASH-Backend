								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"paymentMethod\": \"GCASH\",\n  \"shippingAddress\": {\n    \"region\": \"NCR\",\n    \"province\": \"Metro Manila\",\n    \"city\": \"Quezon City\",\n    \"barangay\": \"Commonwealth\",\n    \"addressLine1\": \"123 Main Street\",\n    \"addressLine2\": \"Unit 456\",\n    \"postalCode\": \"1121\",\n    \"contactNumber\": \"+639171234567\"\n  },\n  \"billingAddress\": {\n    \"region\": \"NCR\",\n    \"province\": \"Metro Manila\",\n    \"city\": \"Quezon City\",\n    \"barangay\": \"Commonwealth\",\n    \"addressLine1\": \"123 Main Street\",\n    \"postalCode\": \"1121\",\n    \"contactNumber\": \"+639171234567\"\n  },\n  \"shippingMethod\": \"STANDARD\",\n  \"notes\": \"Please call before delivery\"\n}"
						},
