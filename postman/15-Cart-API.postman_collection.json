{
	"info": {
		"_postman_id": "cart-api-collection-2025",
		"name": "15-Cart-API",
		"description": "MASH Backend - Shopping Cart API Testing Collection\n\nThis collection covers all cart endpoints including:\n- Guest cart operations\n- Authenticated user cart operations\n- Cart item management (add, update, remove)\n- Cart validation\n- Guest-to-user cart migration\n- Shipping estimation\n- Checkout process\n- Cart analytics (admin)\n\nAuthor: MASH Backend Team\nVersion: 1.0.0\nCreated: November 15, 2025",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Guest Cart Operations",
			"item": [
				{
					"name": "Get or Create Guest Cart",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has cart structure\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('id');",
									"    pm.expect(jsonData).to.have.property('sessionId');",
									"    pm.expect(jsonData).to.have.property('status');",
									"    pm.expect(jsonData).to.have.property('items');",
									"    pm.expect(jsonData).to.have.property('total');",
									"});",
									"",
									"// Save cart ID for subsequent requests",
									"var jsonData = pm.response.json();",
									"pm.environment.set(\"cartId\", jsonData.id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-Session-Id",
								"value": "{{guestSessionId}}",
								"type": "text",
								"description": "Guest session ID for cart identification"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/cart",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"cart"
							]
						},
						"description": "Retrieves the guest cart or creates a new empty cart if none exists. Uses X-Session-Id header for identification."
					},
					"response": []
				},
				{
					"name": "Add Item to Guest Cart",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Cart has items\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.items).to.be.an('array');",
									"    pm.expect(jsonData.items.length).to.be.above(0);",
									"    pm.expect(jsonData.itemCount).to.be.above(0);",
									"});",
									"",
									"pm.test(\"Item has price locked\", function () {",
									"    var jsonData = pm.response.json();",
									"    var item = jsonData.items[0];",
									"    pm.expect(item).to.have.property('price');",
									"    pm.expect(item).to.have.property('productSnapshot');",
									"});",
									"",
									"// Save first cart item ID",
									"var jsonData = pm.response.json();",
									"if (jsonData.items && jsonData.items.length > 0) {",
									"    pm.environment.set(\"cartItemId\", jsonData.items[0].id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "X-Session-Id",
								"value": "{{guestSessionId}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"productId\": \"{{testProductId}}\",\n  \"quantity\": 2,\n  \"customization\": {\n    \"note\": \"Handle with care\",\n    \"giftWrap\": false\n  }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/cart/items",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"cart",
								"items"
							]
						},
						"description": "Adds a product to the guest cart with specified quantity. Performs inventory validation and price locking."
					},
					"response": []
				},
				{
					"name": "Update Cart Item Quantity",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Quantity updated\", function () {",
									"    var jsonData = pm.response.json();",
									"    var item = jsonData.items.find(i => i.id === pm.environment.get('cartItemId'));",
									"    pm.expect(item.quantity).to.equal(5);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "X-Session-Id",
								"value": "{{guestSessionId}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"quantity\": 5,\n  \"customization\": {\n    \"note\": \"Updated note\"\n  }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/cart/items/{{cartItemId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"cart",
								"items",
								"{{cartItemId}}"
							]
						},
						"description": "Updates the quantity of a cart item. Validates stock availability and max quantity limits."
					},
					"response": []
				},
				{
					"name": "Remove Item from Cart",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Item removed\", function () {",
									"    var jsonData = pm.response.json();",
									"    var item = jsonData.items.find(i => i.id === pm.environment.get('cartItemId'));",
									"    pm.expect(item).to.be.undefined;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "X-Session-Id",
								"value": "{{guestSessionId}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/cart/items/{{cartItemId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"cart",
								"items",
								"{{cartItemId}}"
							]
						},
						"description": "Removes a specific item from the cart and recalculates totals."
					},
					"response": []
				},
				{
					"name": "Clear Entire Cart",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Cart is empty\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.items).to.be.an('array').that.is.empty;",
									"    pm.expect(jsonData.itemCount).to.equal(0);",
									"    pm.expect(jsonData.total).to.equal(0);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "X-Session-Id",
								"value": "{{guestSessionId}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/cart",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"cart"
							]
						},
						"description": "Removes all items from the cart."
					},
					"response": []
				},
				{
					"name": "Get Cart Summary",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Summary has key fields\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('itemCount');",
									"    pm.expect(jsonData).to.have.property('total');",
									"    pm.expect(jsonData).to.have.property('subtotal');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-Session-Id",
								"value": "{{guestSessionId}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/cart/summary",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"cart",
								"summary"
							]
						},
						"description": "Gets a lightweight summary of the cart without full product details. Useful for cart badge/icon."
					},
					"response": []
				}
			],
			"description": "Endpoints for managing guest carts using session IDs"
		},
		{
			"name": "Authenticated User Cart",
			"item": [
				{
					"name": "Get User Cart",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Cart belongs to user\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('userId');",
									"    pm.expect(jsonData.sessionId).to.be.null;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/cart",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"cart"
							]
						},
						"description": "Gets the authenticated user's cart. Requires JWT token."
					},
					"response": []
				},
				{
					"name": "Merge Guest Cart to User Cart",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Cart belongs to user after merge\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.userId).to.not.be.null;",
									"    pm.expect(jsonData).to.have.property('items');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
