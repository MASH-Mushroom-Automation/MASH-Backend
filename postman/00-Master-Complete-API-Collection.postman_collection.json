    {
      "name": "Environment Setup",
      "description": "Configuration and environment setup utilities",
      "item": [
        {
          "name": "Set Development Environment",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/debug/env",
              "host": ["{{base_url}}"],
              "path": ["debug", "env"]
            },
            "description": "Configure environment variables for development setup",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "// Set environment variables for development",
                    "pm.environment.set('base_url', 'http://localhost:3000');",
                    "pm.environment.set('environment', 'development');",
                    "console.log('Development environment configured');"
                  ],
                  "type": "text/javascript"
                }
              }
            ]
          },
          "response": []
        },
        {
          "name": "Set Production Environment",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{production_url}}/health",
              "host": ["{{production_url}}"],
              "path": ["health"]
            },
            "description": "Configure environment variables for production setup",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "// Set environment variables for production",
                    "pm.environment.set('base_url', 'https://mashroomautomation-production-49b6.up.railway.app');",
