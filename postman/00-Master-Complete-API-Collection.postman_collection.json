                    "console.log('Production environment configured');"
                  ],
                  "type": "text/javascript"
                }
              }
            ]
          },
          "response": []
        },
        {
          "name": "Clear Authentication Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Clear stored authentication token",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "// Clear authentication token",
                    "pm.environment.set('auth_token', '');",
