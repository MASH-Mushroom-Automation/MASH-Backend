    {
      "name": "Testing Workflows",
      "description": "Automated testing workflows for comprehensive API validation",
      "item": [
        {
          "name": "Complete Authentication Flow Test",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\",\n  \"email\": \"test.{{$randomInt}}@mashroomautomation.com\",\n  \"password\": \"TestPassword123!\",\n  \"confirmPassword\": \"TestPassword123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Automated test for complete authentication workflow",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "pm.test('Registration successful', function () {",
                    "    pm.response.to.have.status(201);",
                    "    const jsonData = pm.response.json();",
                    "    pm.expect(jsonData.success).to.be.true;",
                    "});",
                    "",
                    "if (pm.response.code === 201) {",
                    "    const jsonData = pm.response.json();",
                    "    pm.environment.set('test_user_email', JSON.parse(pm.request.body.raw).email);",
                    "    console.log('Test user registered:', pm.environment.get('test_user_email'));",
                    "}"
                  ],
                  "type": "text/javascript"
                }
              }
            ]
          },
          "response": []
        },
        {
          "name": "Employee Management Flow Test",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Test\",\n  \"lastName\": \"Employee\",\n  \"email\": \"test.employee.{{$randomInt}}@mashroomautomation.com\",\n  \"departmentId\": 1,\n  \"positionId\": 1,\n  \"hireDate\": \"{{$isoTimestamp}}\",\n  \"salary\": 50000\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/employees/",
              "host": ["{{base_url}}"],
              "path": ["api", "employees"]
            },
            "description": "Automated test for employee management workflow",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "pm.test('Employee creation successful', function () {",
                    "    pm.response.to.have.status(201);",
                    "    const jsonData = pm.response.json();",
                    "    pm.expect(jsonData.success).to.be.true;",
                    "    if (jsonData.data && jsonData.data.id) {",
                    "        pm.environment.set('test_employee_id', jsonData.data.id);",
                    "    }",
                    "});"
                  ],
                  "type": "text/javascript"
                }
              }
            ]
          },
          "response": []
        }
      ]
