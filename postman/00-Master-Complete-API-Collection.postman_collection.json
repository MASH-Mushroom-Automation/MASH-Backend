  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global pre-request script for all requests",
          "console.log('Request to: ' + pm.request.url);",
          "",
          "// Add timestamp to requests",
          "pm.globals.set('timestamp', new Date().toISOString());"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global test script for all responses",
          "pm.test('Response time is less than 5000ms', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(5000);",
          "});",
          "",
          "// Auto-save auth token from login responses",
          "if (pm.request.url.toString().includes('/api/auth/login') && pm.response.code === 200) {",
          "    try {",
          "        const jsonData = pm.response.json();",
          "        if (jsonData.token) {",
          "            pm.environment.set('auth_token', jsonData.token);",
          "            console.log('Auth token automatically saved');",
          "        }",
          "    } catch (e) {",
          "        console.log('Could not parse login response');",
          "    }",
          "}"
        ]
      }
    }
  ]
