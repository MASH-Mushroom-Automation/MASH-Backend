    "item": [
        {
            "name": "Add White Oyster Mushrooms",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{ecommerce_accessToken}}"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"name\": \"White Oyster Mushrooms\",\n    \"description\": \"Freshly harvested white oyster mushrooms, perfect for culinary use. Rich in protein and vitamins.\",\n    \"price\": 15.99,\n    \"unit\": \"kg\",\n    \"category\": \"Edible Mushrooms\",\n    \"stock\": 100,\n    \"images\": [\"https://example.com/white-oyster-1.jpg\", \"https://example.com/white-oyster-2.jpg\"],\n    \"tags\": [\"fresh\", \"organic\", \"culinary\"],\n    \"sellerId\": \"{{ecommerce_userId}}\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/ecommerce/products",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "ecommerce",
                        "products"
                    ]
                }
            },
            "response": []
        },
