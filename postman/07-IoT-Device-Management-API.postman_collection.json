{
  "info": {
    "name": "07-IoT-Device-Management-API",
    "_postman_id": "iot-device-mgmt-001",
    "description": "Complete IoT device lifecycle management and fleet operations for MASH Backend.\n\n**Features:**\n- Device registration and onboarding\n- Real-time device monitoring\n- Fleet management with analytics\n- Device control and commands\n- Health monitoring and diagnostics\n- Sensor management\n- Firmware updates (OTA)\n\n**Base URL:** {{baseUrl}}/devices\n**Authentication:** Bearer Token (JWT)\n**Total Endpoints:** 27",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Set base URL if not already set",
          "if (!pm.environment.get('baseUrl')) {",
          "    pm.environment.set('baseUrl', 'http://localhost:3000/api/v1');",
          "}",
          "",
          "// Generate unique test device ID",
          "const timestamp = Date.now();",
          "const random = Math.floor(Math.random() * 1000);",
          "pm.environment.set('testDeviceId', `MASH-TEST-${timestamp}-${random}`);",
          "",
          "// Set current timestamp",
          "pm.environment.set('timestamp', new Date().toISOString());"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Common test assertions",
          "pm.test('Response time is less than 2000ms', function() {",
          "    pm.expect(pm.response.responseTime).to.be.below(2000);",
          "});",
          "",
          "pm.test('Content-Type is application/json', function() {",
          "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Device Registration & Onboarding",
      "item": [
        {
          "name": "Register New Device",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function() {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response has success property', function() {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response).to.have.property('success');",
                  "    pm.expect(response.success).to.be.true;",
                  "});",
                  "",
                  "pm.test('Device data is returned', function() {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response).to.have.property('data');",
                  "    pm.expect(response.data).to.have.property('id');",
                  "    pm.expect(response.data).to.have.property('deviceId');",
                  "    pm.expect(response.data).to.have.property('name');",
                  "    pm.expect(response.data).to.have.property('type');",
                  "    pm.expect(response.data).to.have.property('status');",
                  "});",
                  "",
                  "pm.test('Device status is OFFLINE initially', function() {",
                  "    const device = pm.response.json().data;",
                  "    pm.expect(device.status).to.be.oneOf(['OFFLINE', 'ONLINE']);",
                  "});",
                  "",
                  "// Save device ID for subsequent requests",
                  "if (pm.response.code === 201) {",
                  "    const deviceId = pm.response.json().data.id;",
                  "    pm.environment.set('deviceId', deviceId);",
                  "    console.log('✅ Device registered with ID:', deviceId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"{{testDeviceId}}\",\n  \"name\": \"Test Mushroom Chamber {{$timestamp}}\",\n  \"type\": \"MUSHROOM_CHAMBER\",\n  \"location\": \"Lab Room A - Testing\",\n  \"ipAddress\": \"192.168.1.100\",\n  \"port\": 5000,\n  \"configuration\": {\n    \"spawningTempMin\": 20,\n    \"spawningTempMax\": 25,\n    \"fruitingTempMin\": 15,\n    \"fruitingTempMax\": 20,\n    \"spawningHumidityMin\": 90,\n    \"spawningHumidityMax\": 95,\n    \"fruitingHumidityMin\": 85,\n    \"fruitingHumidityMax\": 90,\n    \"spawningCO2Min\": 10000,\n    \"fruitingCO2Min\": 500,\n    \"fruitingCO2Max\": 800\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/devices",
              "host": ["{{baseUrl}}"],
              "path": ["devices"]
            },
            "description": "Register a new IoT device to the user's account. Device will be created with OFFLINE status initially."
          },
          "response": []
        },
        {
          "name": "List All Devices",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has data array', function() {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response).to.have.property('data');",
                  "    pm.expect(response.data).to.have.property('devices');",
                  "    pm.expect(response.data.devices).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Pagination information included', function() {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.data).to.have.property('pagination');",
                  "    pm.expect(response.data.pagination).to.have.all.keys('page', 'limit', 'total', 'totalPages');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/devices?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["devices"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Retrieve all devices registered to the authenticated user with pagination support."
          },
          "response": []
        },
        {
          "name": "Get Device Details",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Device details returned', function() {",
                  "    const response = pm.response.json();",
                  "    const device = response.data;",
                  "    pm.expect(device).to.have.property('id');",
                  "    pm.expect(device).to.have.property('deviceId');",
                  "    pm.expect(device).to.have.property('name');",
                  "    pm.expect(device).to.have.property('type');",
                  "    pm.expect(device).to.have.property('status');",
                  "    pm.expect(device).to.have.property('configuration');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/devices/{{deviceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["devices", "{{deviceId}}"]
            },
            "description": "Get detailed information about a specific device including configuration and latest readings."
          },
          "response": []
        }
      ],
      "description": "Device registration and onboarding endpoints for secure device management."
    },
