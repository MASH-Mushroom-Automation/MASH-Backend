    {
      "name": "4. API Key Management",
      "item": [
        {
          "name": "List API Keys",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('API keys returned', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('apiKeys');",
                  "    pm.expect(jsonData).to.have.property('stats');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/profile/api-keys",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "profile", "api-keys"]
            },
            "description": "List all API keys (masked). Full keys are never returned after creation."
          },
          "response": []
        },
        {
          "name": "Generate API Key",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('API key generated', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('apiKey');",
                  "    pm.expect(jsonData.apiKey).to.include('mash_sk_');",
                  "});",
                  "",
                  "// Save API key ID for revoke test",
                  "const jsonData = pm.response.json();",
                  "pm.collectionVariables.set('apiKeyId', jsonData.id);",
                  "pm.collectionVariables.set('generatedApiKey', jsonData.apiKey);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My API Key\",\n  \"scopes\": [\"devices:read\", \"sensors:read\"],\n  \"expiresAt\": \"2026-12-31T23:59:59.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/profile/api-keys",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "profile", "api-keys"]
            },
            "description": "Generate a new crypto-secure API key.\n\n**Format:** `mash_sk_{64_random_chars}`\n\n**Security:**\n- Crypto-secure random generation\n- bcrypt hashed before storage\n- Full key shown ONLY ONCE\n\n**⚠️ IMPORTANT:** Save the generated key immediately!"
          },
          "response": []
        },
        {
          "name": "Revoke API Key",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('API key revoked', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('message');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/profile/api-keys/{{apiKeyId}}?reason=Testing",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "profile", "api-keys", "{{apiKeyId}}"],
              "query": [
                {
                  "key": "reason",
                  "value": "Testing",
                  "description": "Optional revocation reason"
                }
              ]
            },
            "description": "Revoke an API key. Soft delete with audit trail."
          },
          "response": []
        }
      ],
