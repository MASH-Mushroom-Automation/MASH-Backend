    },
    {
      "name": "6. Two-Factor Authentication (2FA)",
      "item": [
        {
          "name": "Enable 2FA - Step 1: Generate QR Code",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('QR code generated', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('secret');",
                  "    pm.expect(jsonData).to.have.property('qrCode');",
                  "    pm.expect(jsonData.qrCode).to.include('data:image/png;base64');",
                  "});",
                  "",
                  "// Display QR code in console",
                  "const jsonData = pm.response.json();",
                  "console.log('==================================');",
                  "console.log('2FA SETUP - STEP 1');",
                  "console.log('==================================');",
                  "console.log('');",
                  "console.log('1. Scan this QR code with your authenticator app:');",
                  "console.log('   (Google Authenticator, Authy, Microsoft Authenticator, etc.)');",
                  "console.log('');",
                  "console.log('QR Code Data URL:');",
                  "console.log(jsonData.qrCode);",
                  "console.log('');",
                  "console.log('Manual Entry Key:', jsonData.secret);",
                  "console.log('');",
                  "console.log('2. After scanning, run the \"Enable 2FA - Step 2: Verify\" request');",
                  "console.log('   with the 6-digit code from your authenticator app.');",
                  "console.log('==================================');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/profile/2fa/enable",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "profile", "2fa", "enable"]
            },
            "description": "**Step 1 of 2FA Setup**\n\nGenerate TOTP secret and QR code for authenticator app.\n\n**Instructions:**\n1. Run this request to get QR code\n2. Check Console for QR code data URL\n3. Scan QR code with authenticator app:\n   - Google Authenticator\n   - Authy\n   - Microsoft Authenticator\n   - 1Password\n   - Bitwarden\n4. Get 6-digit code from app\n5. Run \"Step 2: Verify\" request"
          },
          "response": []
        },
        {
          "name": "Enable 2FA - Step 2: Verify Code",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('2FA enabled with backup codes', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('enabled', true);",
                  "    pm.expect(jsonData).to.have.property('backupCodes');",
                  "    pm.expect(jsonData.backupCodes).to.be.an('array');",
                  "    pm.expect(jsonData.backupCodes).to.have.lengthOf(10);",
                  "});",
                  "",
                  "// Display backup codes",
                  "const jsonData = pm.response.json();",
                  "console.log('==================================');",
                  "console.log('2FA ENABLED SUCCESSFULLY!');",
                  "console.log('==================================');",
                  "console.log('');",
                  "console.log('⚠️ SAVE THESE BACKUP CODES SECURELY!');",
                  "console.log('   You will NOT see them again.');",
                  "console.log('');",
                  "console.log('Backup Recovery Codes:');",
                  "jsonData.backupCodes.forEach((code, index) => {",
                  "    console.log(`${index + 1}. ${code}`);",
                  "});",
                  "console.log('');",
                  "console.log('Use these codes if you lose access to your authenticator app.');",
                  "console.log('Each code can only be used once.');",
                  "console.log('==================================');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/profile/2fa/verify",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "profile", "2fa", "verify"]
            },
            "description": "**Step 2 of 2FA Setup**\n\nVerify 6-digit TOTP code and enable 2FA.\n\n**Returns:**\n- 10 backup recovery codes (SHOWN ONLY ONCE)\n- 2FA enabled confirmation\n\n**⚠️ IMPORTANT:**\nSave backup codes securely! You will NOT see them again.\n\n**Body:**\n```json\n{\n  \"token\": \"123456\"  // 6-digit code from authenticator app\n}\n```"
          },
          "response": []
        },
        {
          "name": "Disable 2FA",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('2FA disabled', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('disabled', true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/profile/2fa/disable",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "profile", "2fa", "disable"]
            },
            "description": "Disable 2FA for the account.\n\n**Security:** Requires valid TOTP code to prevent unauthorized disabling.\n\n**Body:**\n```json\n{\n  \"token\": \"123456\"  // Current 6-digit code from authenticator app\n}\n```"
          },
          "response": []
        },
        {
          "name": "Regenerate Backup Codes",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('New backup codes generated', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('backupCodes');",
                  "    pm.expect(jsonData.backupCodes).to.have.lengthOf(10);",
                  "});",
                  "",
                  "// Display new backup codes",
                  "const jsonData = pm.response.json();",
                  "console.log('==================================');",
                  "console.log('NEW BACKUP CODES GENERATED');",
                  "console.log('==================================');",
