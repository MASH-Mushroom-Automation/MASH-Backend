    },
    {
      "name": "5. Security Audit Trail",
      "item": [
        {
          "name": "Get Security Log",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Security log returned', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('logs');",
                  "    pm.expect(jsonData).to.have.property('pagination');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/profile/security-log?page=1&limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "profile", "security-log"],
              "query": [
                {
                  "key": "action",
                  "value": "LOGIN",
                  "description": "Filter by event name",
                  "disabled": true
                },
                {
                  "key": "dateFrom",
