  "item": [
    {
      "name": "Seller Management",
      "item": [
        {
          "name": "Register as Seller",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"businessName\": \"{{businessName}}\",\n  \"businessType\": \"{{businessType}}\",\n  \"businessDescription\": \"{{businessDescription}}\",\n  \"businessAddress\": {\n    \"street\": \"{{businessStreet}}\",\n    \"city\": \"{{businessCity}}\",\n    \"state\": \"{{businessState}}\",\n    \"zipCode\": \"{{businessZipCode}}\",\n    \"country\": \"{{businessCountry}}\"\n  },\n  \"businessPhone\": \"{{businessPhone}}\",\n  \"businessEmail\": \"{{businessEmail}}\",\n  \"businessWebsite\": \"{{businessWebsite}}\",\n  \"taxId\": \"{{taxId}}\",\n  \"bankAccount\": {\n    \"accountNumber\": \"{{accountNumber}}\",\n    \"routingNumber\": \"{{routingNumber}}\",\n    \"bankName\": \"{{bankName}}\"\n  },\n  \"specialties\": [\"{{specialty1}}\", \"{{specialty2}}\", \"{{specialty3}}\"],\n  \"yearsInBusiness\": {{yearsInBusiness}},\n  \"certifications\": [\"{{certification1}}\", \"{{certification2}}\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sellers/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sellers", "register"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Seller registration successful\", function () {",
                  "    pm.response.to.have.status(201);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('seller');",
                  "    pm.expect(jsonData.seller).to.have.property('_id');",
                  "    ",
                  "    // Set seller ID for subsequent requests",
                  "    pm.environment.set(\"sellerId\", jsonData.seller._id);",
                  "});"
                ]
              }
            }
          ]
        },
